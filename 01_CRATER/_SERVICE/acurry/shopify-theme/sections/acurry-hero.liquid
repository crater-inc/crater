{%- style -%}
  .acurry-kv{
    position:relative;
    min-height:{{ section.settings.height }}px;
    display:flex;align-items:center;justify-content:center;
    text-align:center;overflow:hidden;
    background:{{ section.settings.bg }};
  }
  .acurry-kv__content{position:relative;z-index:2;color:#fff;padding:64px 24px;max-width:1000px;}
  .acurry-kv__eyebrow{
    font-size:clamp(11px,1vw,13px);letter-spacing:.5em;text-transform:uppercase;
    margin:0 0 28px;opacity:.6;padding-left:.5em;
  }
  .acurry-kv__heading{
    font-size:clamp(32px,5.4vw,72px);line-height:1.35;margin:0 0 40px;
    letter-spacing:.08em;font-weight:500;
  }
  .acurry-kv__btn{
    display:inline-block;padding:17px 52px;background:transparent;color:#fff;
    text-decoration:none;letter-spacing:.22em;font-size:12px;text-transform:uppercase;
    border:1px solid rgba(255,255,255,.6);transition:background .35s,color .35s,border-color .35s;
  }
  .acurry-kv__btn:hover{background:#fff;color:{{ section.settings.bg }};border-color:#fff;}
  @media(max-width:749px){
    .acurry-kv{min-height:{{ section.settings.height_mobile }}px;}
    .acurry-kv__content{padding:48px 28px;}
    .acurry-kv__eyebrow{letter-spacing:.38em;margin-bottom:20px;}
    .acurry-kv__heading{letter-spacing:.05em;margin-bottom:32px;}
  }
{%- endstyle -%}

<div class="acurry-kv">
  <div class="acurry-kv__content">
    {%- if section.settings.eyebrow != blank -%}
      <p class="acurry-kv__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h1 class="acurry-kv__heading">{{ section.settings.heading }}</h1>
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="acurry-kv__btn">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "A CURRY KV",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "上の小さい文字", "default": "A CURRY" },
    { "type": "text", "id": "heading", "label": "見出し", "default": "記憶に残る、この一皿。" },
    { "type": "text", "id": "button_label", "label": "ボタン文言", "default": "商品を見る" },
    { "type": "url", "id": "button_link", "label": "ボタンリンク" },
    { "type": "color", "id": "bg", "label": "背景色", "default": "#111111" },
    { "type": "range", "id": "height", "min": 460, "max": 900, "step": 20, "unit": "px", "label": "高さ(PC)", "default": 660 },
    { "type": "range", "id": "height_mobile", "min": 360, "max": 700, "step": 20, "unit": "px", "label": "高さ(SP)", "default": 500 }
  ],
  "presets": [{ "name": "A CURRY KV" }]
}
{% endschema %}
