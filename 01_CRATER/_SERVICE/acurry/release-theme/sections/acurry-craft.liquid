{%- comment -%} A CURRY こだわり・製法（画像左／テキスト右） {%- endcomment -%}
<style>
  .acu-craft{display:grid;grid-template-columns:1fr 1fr;background:var(--acu-paper);}
  .acu-craft__img{position:relative;min-height:520px;background:linear-gradient(135deg,#d6d6d6,#aeaeae);overflow:hidden;}
  .acu-craft__img img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:1!important;}
  .acu-craft__body{display:flex;flex-direction:column;justify-content:center;gap:18px;padding:64px 72px;}
  .acu-craft__eye{font-family:var(--acu-en);font-size:12px;letter-spacing:3px;color:var(--acu-sub);}
  .acu-craft__t{font-family:var(--acu-en);font-weight:600;font-size:clamp(28px,3.2vw,40px);color:var(--acu-ink);margin:0;}
  .acu-craft__jp{font-family:var(--acu-jp);font-weight:600;font-size:13px;letter-spacing:3px;color:var(--acu-meta,#888);margin:0;}
  .acu-craft__d{font-family:var(--acu-jp);font-size:15px;line-height:1.9;color:#444;margin:0;}
  @media(max-width:768px){.acu-craft{grid-template-columns:1fr;}.acu-craft__img{min-height:280px;}.acu-craft__body{padding:48px 32px;}}
</style>
<section class="acu acu-craft">
  <div class="acu-craft__img">{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 1200 }}" alt="" loading="lazy">{%- else -%}<img src="{{ 'acurry-craft.jpg' | asset_url }}" alt="" loading="lazy">{%- endif -%}</div>
  <div class="acu-craft__body">
    <h2 class="acu-craft__t">{{ section.settings.heading }}</h2>
    {%- if section.settings.subheading != blank -%}<div class="acu-craft__jp">{{ section.settings.subheading }}</div>{%- endif -%}
    <p class="acu-craft__d">{{ section.settings.body }}</p>
  </div>
</section>
{% schema %}
{
  "name": "A CURRY Craft",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "上ラベル", "default": "CRAFT" },
    { "type": "text", "id": "heading", "label": "見出し(英語)", "default": "The Craft" },
    { "type": "image_picker", "id": "image", "label": "画像（未設定＝グレーのダミー）" },
    { "type": "text", "id": "subheading", "label": "サブ(日本語)", "default": "専門店監修のレシピ" },
    { "type": "textarea", "id": "body", "label": "本文", "default": "ご当地レトルトカレー専門店「カレーランド」監修（牡蠣とココナッツ／柚子胡椒豚の2種）。厳選した素材を、味ごとに設計したレシピで丁寧に仕上げました。" }
  ],
  "presets": [{ "name": "A CURRY Craft" }]
}
{% endschema %}
