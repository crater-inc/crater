<section id="acu2" class="acu-root" style="--curry:#{{ curry }};--accent:#{{ accent }};">

<div class="breadcrumb"><a href="{{ routes.root_url }}">HOME</a> / <a href="{{ routes.all_products_collection_url }}">SHOP</a> / {{ product.title }}</div>

<section class="product">
  <div class="gallery">
    <div class="main">
      {%- if product.featured_image -%}
        <img id="acuMain" src="{{ product.featured_image | image_url: width: 1000 }}" alt="{{ product.title | escape }}">
      {%- else -%}商品写真{%- endif -%}
    </div>
    <div class="thumbs">
      {%- if product.images.size > 1 -%}
        {%- for image in product.images limit: 5 -%}
          <button class="thumb{% if forloop.first %} active{% endif %}" data-full="{{ image | image_url: width: 1000 }}"><img src="{{ image | image_url: width: 220 }}" alt="" loading="lazy"></button>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..5) -%}<button class="{% if forloop.first %}active{% endif %}">写真</button>{%- endfor -%}
      {%- endif -%}
    </div>
  </div>

  <div class="col-right">
    <div class="info block">
      <div class="cat">{{ cat_en }}</div>
      <h1 class="name">{{ product.title }}</h1>
      <div class="price">{{ product.price | money }}（税込）</div>
      <p class="desc">{{ flavor_desc }}</p>
      <div class="chips">
        {%- for c in chips -%}<span class="chip">{{ c }}</span>{%- endfor -%}
      </div>
      {%- form 'product', product, class: 'buy' -%}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <div class="qty">
          <button type="button" onclick="var i=this.parentNode.querySelector('input');i.value=Math.max(1,parseInt(i.value||1)-1)">−</button>
          <input type="number" name="quantity" value="1" min="1" inputmode="numeric">
          <button type="button" onclick="var i=this.parentNode.querySelector('input');i.value=parseInt(i.value||1)+1">＋</button>
        </div>
        <button type="submit" class="cart-btn" {% unless product.available %}disabled{% endunless %}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
          {% if product.available %}カートに入れる{% else %}売り切れ{% endif %}
        </button>
      {%- endform -%}
      <a class="vp-xsell" href="/products/value-pack">3個まとめ買いは <strong>バリューパックが{{ 36000 | money }}おトク</strong> →</a>
      <div class="spec">
        <div class="row"><span class="rk"><span class="material-symbols-rounded">package_2</span><span class="kt">内容量</span></span><span class="rv">200g（1人前）</span></div>
        <div class="row"><span class="rk"><span class="material-symbols-rounded">local_fire_department</span><span class="kt">辛さ</span></span><span class="rv">{{ spice }}</span></div>
        <div class="row"><span class="rk"><span class="material-symbols-rounded">calendar_month</span><span class="kt">賞味期限</span></span><span class="rv">{{ bestbefore }}</span></div>
        <div class="row"><span class="rk"><span class="material-symbols-rounded">factory</span><span class="kt">製造</span></span><span class="rv">キャニオンスパイス</span></div>
      </div>
    </div>

    <div class="fb block">
      <div class="fb-en en">First Bite</div>
      <div class="fb-copy mincho">ひと口目に、小さな「あ！」。</div>
      <div class="fb-sub">{{ fbsub }}</div>
      <div class="fb-img">素材カット</div>
    </div>

    <div class="recipe block">
      <div class="ey">THE RECIPE</div>
      <h2 class="h">{{ recipe_h }}</h2>
      <p class="b">{{ recipe_b }}</p>
    </div>

    <div class="ingredients block">
      <div class="ing-head">
        <div class="en">Ingredients</div>
        <div class="jp">素材のこだわり</div>
      </div>
      <div class="ing-list">
        <div class="ing-item">
          <div class="iimg"><img src="{{ 'acurry-mat-' | append: ing_prefix | append: '1.jpg' | asset_url }}" alt="{{ ing1_nm }}"></div>
          <div class="itxt"><div class="inm">{{ ing1_nm }}</div><div class="idesc">{{ ing1_desc }}</div></div>
        </div>
        <div class="ing-item">
          <div class="iimg"><img src="{{ 'acurry-mat-' | append: ing_prefix | append: '2.jpg' | asset_url }}" alt="{{ ing2_nm }}"></div>
          <div class="itxt"><div class="inm">{{ ing2_nm }}</div><div class="idesc">{{ ing2_desc }}</div></div>
        </div>
        <div class="ing-item">
          <div class="iimg"><img src="{{ 'acurry-mat-' | append: ing_prefix | append: '3.jpg' | asset_url }}" alt="{{ ing3_nm }}"></div>
          <div class="itxt"><div class="inm">{{ ing3_nm }}</div><div class="idesc">{{ ing3_desc }}</div></div>
        </div>
      </div>
    </div>

    <div class="zairyo block">
      <div class="zairyo-head">
        <div class="en">Allergens</div>
        <div class="jp">原材料・アレルゲン</div>
      </div>
      <div class="table">
        <div class="trow"><div class="tk"><span class="material-symbols-rounded">restaurant</span>原材料名</div><div class="tv">{{ zairyo_name }}</div></div>
        <div class="trow"><div class="tk"><span class="material-symbols-rounded">warning</span>含む（一部）</div><div class="tv">{{ al_contains }}</div></div>
        <div class="trow"><div class="tk"><span class="material-symbols-rounded">factory</span>同工場で製造</div><div class="tv">{{ al_factory }}</div></div>
        <div class="trow"><div class="tk"><span class="material-symbols-rounded">nutrition</span>栄養成分（200g）</div><div class="tv">{{ nutrition }}</div></div>
        <div class="trow"><div class="tk"><span class="material-symbols-rounded">thermostat</span>保存・殺菌</div><div class="tv">直射日光を避け常温で保存。気密性容器に密封し、加圧加熱殺菌。</div></div>
        <div class="trow"><div class="tk"><span class="material-symbols-rounded">storefront</span>製造・販売</div><div class="tv">製造：キャニオンスパイス（大阪府泉南市）／販売：株式会社クレーター</div></div>
      </div>
    </div>

    <div class="eat block">
      <div class="eat-head">
        <div class="en">How to Eat</div>
        <div class="jp">3ステップで、あ！</div>
      </div>
      <div class="steps">
        <div class="step"><div class="num en">01</div><div><div class="st">温める</div><div class="sd">袋のまま熱湯で5〜7分。電子レンジは中身を耐熱容器に移しラップをかけ、500Wで約2分温めます。</div></div></div>
        <div class="step"><div class="num en">02</div><div><div class="st">かける</div><div class="sd">炊きたてのごはんにたっぷりと。お好みでルウとごはんは別皿にしても。</div></div></div>
        <div class="step"><div class="num en">03</div><div><div class="st">味わう</div><div class="sd">{{ eat3 }}</div></div></div>
      </div>
    </div>
  </div>
</section>

<section class="voice">
  <div class="voice-inner">
    <div class="voice-head">
      <div class="en">Voice</div>
      <div class="jp">お客様の声</div>
    </div>
    <div class="summary">
      <div class="stars"><svg viewBox="0 0 24 24"><path d="M12 2l3 6.9 7.5.6-5.7 4.9 1.8 7.3L12 17.8 5.1 21.7l1.8-7.3L1.2 9.5l7.5-.6z"/></svg><svg viewBox="0 0 24 24"><path d="M12 2l3 6.9 7.5.6-5.7 4.9 1.8 7.3L12 17.8 5.1 21.7l1.8-7.3L1.2 9.5l7.5-.6z"/></svg><svg viewBox="0 0 24 24"><path d="M12 2l3 6.9 7.5.6-5.7 4.9 1.8 7.3L12 17.8 5.1 21.7l1.8-7.3L1.2 9.5l7.5-.6z"/></svg><svg viewBox="0 0 24 24"><path d="M12 2l3 6.9 7.5.6-5.7 4.9 1.8 7.3L12 17.8 5.1 21.7l1.8-7.3L1.2 9.5l7.5-.6z"/></svg><svg viewBox="0 0 24 24"><path d="M12 2l3 6.9 7.5.6-5.7 4.9 1.8 7.3L12 17.8 5.1 21.7l1.8-7.3L1.2 9.5l7.5-.6z"/></svg></div>
      <div class="score en">5.0</div>
      <div class="cnt">20件のレビュー</div>
    </div>
    <div class="cards">
      <div class="card">
        <div class="cstars"><svg viewBox="0 0 24 24"><path d="M12 2l3 6.9 7.5.6-5.7 4.9 1.8 7.3L12 17.8 5.1 21.7l1.8-7.3L1.2 9.5l7.5-.6z"/></svg><svg viewBox="0 0 24 24"><path d="M12 2l3 6.9 7.5.6-5.7 4.9 1.8 7.3L12 17.8 5.1 21.7l1.8-7.3L1.2 9.5l7.5-.6z"/></svg><svg viewBox="0 0 24 24"><path d="M12 2l3 6.9 7.5.6-5.7 4.9 1.8 7.3L12 17.8 5.1 21.7l1.8-7.3L1.2 9.5l7.5-.6z"/></svg><svg viewBox="0 0 24 24"><path d="M12 2l3 6.9 7.5.6-5.7 4.9 1.8 7.3L12 17.8 5.1 21.7l1.8-7.3L1.2 9.5l7.5-.6z"/></svg><svg viewBox="0 0 24 24"><path d="M12 2l3 6.9 7.5.6-5.7 4.9 1.8 7.3L12 17.8 5.1 21.7l1.8-7.3L1.2 9.5l7.5-.6z"/></svg></div>
        <div class="ct">また、絶対に買う。</div>
        <div class="cb">スパイスの香りが本格的で、レトルトの概念が変わりました。ひと口目で本当に「あ！」と声が出た。</div>
        <div class="cn">40代・女性</div>
      </div>
      <div class="card">
        <div class="cstars"><svg viewBox="0 0 24 24"><path d="M12 2l3 6.9 7.5.6-5.7 4.9 1.8 7.3L12 17.8 5.1 21.7l1.8-7.3L1.2 9.5l7.5-.6z"/></svg><svg viewBox="0 0 24 24"><path d="M12 2l3 6.9 7.5.6-5.7 4.9 1.8 7.3L12 17.8 5.1 21.7l1.8-7.3L1.2 9.5l7.5-.6z"/></svg><svg viewBox="0 0 24 24"><path d="M12 2l3 6.9 7.5.6-5.7 4.9 1.8 7.3L12 17.8 5.1 21.7l1.8-7.3L1.2 9.5l7.5-.6z"/></svg><svg viewBox="0 0 24 24"><path d="M12 2l3 6.9 7.5.6-5.7 4.9 1.8 7.3L12 17.8 5.1 21.7l1.8-7.3L1.2 9.5l7.5-.6z"/></svg><svg viewBox="0 0 24 24"><path d="M12 2l3 6.9 7.5.6-5.7 4.9 1.8 7.3L12 17.8 5.1 21.7l1.8-7.3L1.2 9.5l7.5-.6z"/></svg></div>
        <div class="ct">{{ voice_ct }}</div>
        <div class="cb">{{ voice_cb }}</div>
        <div class="cn">30代・男性</div>
      </div>
      <div class="card">
        <div class="cstars"><svg viewBox="0 0 24 24"><path d="M12 2l3 6.9 7.5.6-5.7 4.9 1.8 7.3L12 17.8 5.1 21.7l1.8-7.3L1.2 9.5l7.5-.6z"/></svg><svg viewBox="0 0 24 24"><path d="M12 2l3 6.9 7.5.6-5.7 4.9 1.8 7.3L12 17.8 5.1 21.7l1.8-7.3L1.2 9.5l7.5-.6z"/></svg><svg viewBox="0 0 24 24"><path d="M12 2l3 6.9 7.5.6-5.7 4.9 1.8 7.3L12 17.8 5.1 21.7l1.8-7.3L1.2 9.5l7.5-.6z"/></svg><svg viewBox="0 0 24 24"><path d="M12 2l3 6.9 7.5.6-5.7 4.9 1.8 7.3L12 17.8 5.1 21.7l1.8-7.3L1.2 9.5l7.5-.6z"/></svg><svg viewBox="0 0 24 24"><path d="M12 2l3 6.9 7.5.6-5.7 4.9 1.8 7.3L12 17.8 5.1 21.7l1.8-7.3L1.2 9.5l7.5-.6z"/></svg></div>
        <div class="ct">これをギフトにしました。</div>
        <div class="cb">パッケージがおしゃれで、渡した相手にすごく喜ばれた。味も間違いなくて、また贈りたい一皿です。</div>
        <div class="cn">50代・女性</div>
      </div>
    </div>
  </div>
</section>

<section class="other">
  <div class="other-head">
    <div class="en">Other Curry</div>
    <div class="jp">ほかの「あ！」</div>
  </div>
  {%- if product.collections.size > 0 -%}{%- assign relcol = product.collections.first -%}{%- else -%}{%- assign relcol = collections.all -%}{%- endif -%}
  <div class="other-grid">
    {%- assign shown = 0 -%}
    {%- for p in relcol.products -%}
      {%- if p.id != product.id and shown < 3 -%}
        {%- assign shown = shown | plus: 1 -%}
        {%- assign rkey = 'A3CC44' -%}
        {%- if p.title contains '肉じゃが' -%}{%- assign rkey = 'E99980' -%}{%- elsif p.title contains '牡蠣' or p.title contains 'ココナッツ' -%}{%- assign rkey = 'F2C645' -%}{%- endif -%}
        <a class="other-card" href="{{ p.url }}">
          <div class="oimg" style="background:#{{ rkey }}">{% if p.featured_image %}<img src="{{ p.featured_image | image_url: width: 700 }}" alt="{{ p.title | escape }}">{% else %}商品写真{% endif %}</div>
          <div class="onm">{{ p.title }}</div>
          <div class="opr">{{ p.price | money }}</div>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

</section>

<script>
  (function(){
    var root = document.getElementById('acu2'); if(!root) return;
    var main = root.querySelector('#acuMain');
    var thumbs = root.querySelectorAll('.thumbs button');
    thumbs.forEach(function(btn){
      var full = btn.getAttribute('data-full');
      btn.addEventListener('click', function(){
        thumbs.forEach(function(b){ b.classList.remove('active'); });
        btn.classList.add('active');
        if(full && main){ main.src = full; }
      });
      if(full && main){ btn.addEventListener('mouseenter', function(){ main.src = full; }); }
    });
  })();
</script>
{% schema %}
{
  "name": "A CURRY Product",
  "settings": [],
  "presets": [{ "name": "A CURRY Product" }]
}
{% endschema %}
