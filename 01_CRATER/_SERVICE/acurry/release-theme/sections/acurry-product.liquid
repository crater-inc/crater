#acu2 .cart-btn[disabled]{opacity:.4;cursor:not-allowed;}
#acu2 .vp-xsell{display:inline-block;width:fit-content;margin-top:-8px;font-family:'Noto Sans JP',sans-serif;font-size:13px;color:#555;text-decoration:none;border-bottom:1px solid #bbb;padding-bottom:2px;}#acu2 .vp-xsell strong{color:var(--ink);font-weight:600;}#acu2 .vp-xsell:hover{color:var(--ink);border-color:#666;}
