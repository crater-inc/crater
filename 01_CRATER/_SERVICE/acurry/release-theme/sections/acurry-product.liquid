    assign ing1_nm = '国産牡蠣'
    assign ing1_desc = '海のミルクと呼ばれる濃厚な旨み。磯の香りが余韻をつくります。'
    assign ing2_nm = 'ココナッツミルク'
    assign ing2_desc = 'ヤシのミルクのやさしい甘み。牡蠣の旨みをまろやかに包みます。'
    assign ing3_nm = 'かぼちゃ &amp; マンゴー'
    assign ing3_desc = '隠し味のコクとやさしい甘み。スープに奥行きを与えます。'
