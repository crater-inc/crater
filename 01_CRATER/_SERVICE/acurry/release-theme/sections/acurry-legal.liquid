{%- comment -%} A CURRY 特定商取引法に基づく表記（ラベル／値の定義リスト） {%- endcomment -%}
<style>
  .acu-lg{background:var(--acu-paper);padding:96px 64px;}
  .acu-lg__inner{max-width:860px;margin:0 auto;}
  .acu-lg__eyebrow{font-family:var(--acu-en);font-size:12px;letter-spacing:3px;color:var(--acu-sub);}
  .acu-lg__t{font-family:var(--acu-en);font-weight:600;font-size:clamp(38px,5vw,60px);color:var(--acu-ink);line-height:1.05;margin:10px 0 6px;}
  .acu-lg__jp{font-family:var(--acu-jp);font-weight:600;font-size:14px;letter-spacing:2px;color:#555;}
  .acu-lg__intro{font-family:var(--acu-jp);font-size:15px;line-height:1.9;color:#444;margin:32px 0 8px;}
  .acu-lg__list{margin:40px 0 0;}
  .acu-lg__row{display:flex;gap:32px;padding:22px 0;border-bottom:1px solid var(--acu-line);}
  .acu-lg__row dt{flex:0 0 240px;font-family:var(--acu-jp);font-weight:600;font-size:15px;color:var(--acu-ink);margin:0;line-height:1.7;}
  .acu-lg__row dd{flex:1;font-family:var(--acu-jp);font-size:15px;line-height:1.9;color:#444;margin:0;}
  .acu-lg__row dd a{color:var(--acu-ink);}
  @media(max-width:768px){
    .acu-lg{padding:64px 32px;}
    .acu-lg__row{flex-direction:column;gap:6px;padding:18px 0;}
    .acu-lg__row dt{flex:none;}
  }
</style>
<section class="acu acu-lg">
  <div class="acu-lg__inner">
    <div class="acu-lg__head">
      {%- if section.settings.eyebrow != blank -%}<div class="acu-lg__eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
      <h1 class="acu-lg__t">{{ section.settings.heading }}</h1>
      {%- if section.settings.subheading != blank -%}<div class="acu-lg__jp">{{ section.settings.subheading }}</div>{%- endif -%}
    </div>
    {%- if section.settings.intro != blank -%}<p class="acu-lg__intro">{{ section.settings.intro }}</p>{%- endif -%}
    <dl class="acu-lg__list">
      {%- for block in section.blocks -%}
        <div class="acu-lg__row" {{ block.shopify_attributes }}>
          <dt>{{ block.settings.label }}</dt>
          <dd>{{ block.settings.value | newline_to_br }}</dd>
        </div>
      {%- endfor -%}
    </dl>
  </div>
</section>
{% schema %}
{
  "name": "A CURRY 特商法",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "英字ラベル", "default": "LEGAL NOTICE" },
    { "type": "text", "id": "heading", "label": "見出し(英)", "default": "Legal Notice" },
    { "type": "text", "id": "subheading", "label": "見出し(日)", "default": "特定商取引法に基づく表記" },
    { "type": "textarea", "id": "intro", "label": "導入文" }
  ],
  "blocks": [
    { "type": "row", "name": "項目", "settings": [
      { "type": "text", "id": "label", "label": "項目名", "default": "販売業者" },
      { "type": "textarea", "id": "value", "label": "内容", "default": "－" }
    ]}
  ]
}
{% endschema %}
