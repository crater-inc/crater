{%- comment -%} A CURRY バリューパック（味を選ぶ・3個入り）PDP。柚子デザイン基準に統一 {%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Noto+Serif+JP:wght@500;600;700&family=Noto+Sans+JP:wght@400;500;600&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..0&display=block" rel="stylesheet">
<style>
  #acuvp{
    --ink:#1a1a1a;--sub:#555;--meta:#888;--line:#0000001a;--hair:#0000000f;
    --bg:#b3b3b3;--gold:#c9a24f;--accent:#c9a24f;
  }
  #acuvp *{margin:0;padding:0;box-sizing:border-box;}
  #acuvp{font-family:'Noto Sans JP',sans-serif;color:var(--ink);background:var(--bg);line-height:1.7;overflow-x:clip;-webkit-font-smoothing:antialiased;scroll-behavior:smooth;}
  #acuvp img{max-width:100%;display:block;}
  #acuvp a{color:inherit;text-decoration:none;}
  #acuvp button{font-family:inherit;cursor:pointer;}
  #acuvp .en{font-family:'Playfair Display',serif;}
  #acuvp .mincho{font-family:'Noto Serif JP',serif;}
  #acuvp .material-symbols-rounded{font-variation-settings:'FILL' 0,'wght' 400,'GRAD' 0,'opsz' 24;line-height:1;}
  /* パンくず */
  #acuvp .breadcrumb{max-width:1720px;margin:0 auto;padding:26px 48px 0;font-family:'Playfair Display',serif;font-size:12px;letter-spacing:2px;color:#000;}
  #acuvp .breadcrumb a:hover{text-decoration:underline;}
  /* 2カラム */
  #acuvp .product{max-width:1720px;margin:0 auto;padding:36px 48px 0;display:grid;grid-template-columns:minmax(0,1.2fr) minmax(360px,1fr);gap:48px;align-items:start;}
  /* 左：sticky ビジュアル（味で色が変わる） */
  #acuvp .gallery{position:sticky;top:96px;}
  #acuvp .visual{aspect-ratio:460/663;border-radius:8px;overflow:hidden;background:#E99980;transition:background .35s ease;position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;color:#ffffffee;}
  #acuvp .visual .x3{font-family:'Playfair Display',serif;font-weight:600;font-size:clamp(72px,10vw,120px);line-height:1;}
  #acuvp .visual .vl{font-family:'Playfair Display',serif;font-size:13px;letter-spacing:5px;}
  #acuvp .visual .boxes{position:absolute;bottom:34px;display:flex;gap:10px;}
  #acuvp .visual .boxes span{width:34px;height:46px;border:1.5px solid #ffffffcc;border-radius:4px;}
  /* 右：コンテンツ */
  #acuvp .col-right{display:flex;flex-direction:column;gap:72px;}
  #acuvp .block{display:flex;flex-direction:column;}
  /* 商品情報 */
  #acuvp .info{display:flex;flex-direction:column;gap:20px;}
  #acuvp .info .cat{font-family:'Playfair Display',serif;font-size:20px;font-weight:600;letter-spacing:3px;color:#00000099;}
  #acuvp .info .name{font-family:'Noto Serif JP',serif;font-size:34px;font-weight:600;letter-spacing:1px;line-height:1.35;}
  #acuvp .info .price{font-size:22px;font-weight:600;}
  #acuvp .info .price small{font-size:13px;font-weight:400;color:var(--sub);margin-left:8px;letter-spacing:.5px;}
  #acuvp .save{align-self:flex-start;background:#eef3e4;border:1px solid #cddba9;color:#4a5a24;font-size:12.5px;font-weight:600;padding:6px 13px;border-radius:6px;}
  #acuvp .info .desc{font-size:15px;line-height:1.9;color:var(--sub);}
  #acuvp .pick-h{font-size:13px;font-weight:600;color:#333;}
  #acuvp .flavors{display:flex;flex-wrap:wrap;gap:10px;}
  #acuvp .flavor{font-size:14px;font-weight:600;color:#333;background:#f2f2f2;border:1.5px solid #00000022;border-radius:8px;padding:12px 18px;transition:border-color .2s,background .2s,color .2s;}
  #acuvp .flavor:hover{border-color:#888;}
  #acuvp .flavor.active{border-color:var(--ink);background:#111;color:#f7f4ef;}
  #acuvp .flavor[disabled]{opacity:.4;cursor:not-allowed;}
  #acuvp .cart-btn{height:56px;border:none;border-radius:8px;background:#111;color:#f7f4ef;display:flex;align-items:center;justify-content:center;gap:10px;font-size:15px;font-weight:600;letter-spacing:1px;transition:background .2s;}
  #acuvp .cart-btn svg{width:18px;height:18px;}
  #acuvp .cart-btn:hover{background:#000;}
  #acuvp .note{font-size:13px;line-height:1.85;color:#666;}
  #acuvp .note a{color:var(--ink);border-bottom:1px solid #999;padding-bottom:1px;}
  /* セクション見出し */
  #acuvp .sec-head .en{font-family:'Playfair Display',serif;font-size:40px;font-weight:600;color:#111;line-height:1.16;}
  #acuvp .sec-head .jp{font-size:13px;font-weight:600;letter-spacing:3px;color:var(--sub);margin-top:6px;}
  /* 選べる3つの味（縦積みカード） */
  #acuvp .flist{display:flex;flex-direction:column;gap:28px;margin-top:26px;}
  #acuvp .fitem{display:flex;gap:18px;align-items:center;}
  #acuvp .fitem .sw{width:96px;height:96px;flex-shrink:0;border-radius:8px;}
  #acuvp .fitem .ftx{display:flex;flex-direction:column;gap:5px;min-width:0;}
  #acuvp .fitem .fnm{font-size:18px;font-weight:600;color:var(--ink);}
  #acuvp .fitem .fds{font-size:14px;line-height:1.8;color:var(--sub);}
  #acuvp .fitem .flk{font-family:'Playfair Display',serif;font-size:11px;letter-spacing:2px;color:#333;border-bottom:1px solid #333;padding-bottom:2px;align-self:flex-start;margin-top:2px;}
  /* How to Eat */
  #acuvp .eat-head .en{font-family:'Playfair Display',serif;font-size:40px;font-weight:600;color:#111;line-height:1.16;}
  #acuvp .eat-head .jp{font-size:13px;font-weight:600;letter-spacing:3px;color:#333;margin-top:6px;}
  #acuvp .steps{display:flex;flex-direction:column;margin-top:20px;}
  #acuvp .step{display:flex;gap:20px;align-items:flex-start;padding:26px 0;}
  #acuvp .step+.step{border-top:1px solid var(--line);}
  #acuvp .step .num{font-family:'Playfair Display',serif;font-size:30px;font-weight:600;color:#1a1a1a;}
  #acuvp .step .st{font-family:'Noto Serif JP',serif;font-size:19px;font-weight:600;}
  #acuvp .step .sd{font-size:14px;line-height:1.85;color:var(--sub);margin-top:8px;}
  /* Other Curry */
  #acuvp .other{max-width:1720px;margin:0 auto;padding:80px 48px 96px;}
  #acuvp .other-head .en{font-family:'Playfair Display',serif;font-size:40px;font-weight:600;color:#1a1a1a;line-height:1.16;}
  #acuvp .other-head .jp{font-size:13px;font-weight:600;letter-spacing:3px;color:#555;margin-top:6px;}
  #acuvp .other-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:36px;}
  #acuvp .other-card .oimg{width:100%;aspect-ratio:4/5;border-radius:8px;overflow:hidden;display:flex;align-items:center;justify-content:center;color:#ffffffcc;font-size:11px;letter-spacing:2px;}
  #acuvp .other-card .oimg img{width:100%;height:100%;object-fit:cover;}
  #acuvp .other-card .onm{font-size:16px;font-weight:600;margin-top:14px;line-height:1.5;}
  #acuvp .other-card .opr{font-size:14px;color:#555;margin-top:4px;}
  @media(max-width:768px){
    #acuvp .breadcrumb{padding:22px 32px 0;}
    #acuvp .product{grid-template-columns:1fr;gap:40px;padding:24px 32px 0;}
    #acuvp .gallery{position:static;}
    #acuvp .col-right{gap:56px;}
    #acuvp .info .name{font-size:28px;}
    #acuvp .other{padding:64px 32px 72px;}
    #acuvp .other-grid{grid-template-columns:1fr;}
  }
</style>

{%- liquid
  assign single3 = 354000
  assign saveamt = 36000
-%}
<section id="acuvp" class="acu">

  <div class="breadcrumb"><a href="{{ routes.root_url }}">HOME</a> / <a href="{{ routes.all_products_collection_url }}">SHOP</a> / {{ product.title }}</div>

  <section class="product">
    <div class="gallery">
      <div class="visual" id="vpVisual">
        <div class="x3">×3</div>
        <div class="vl">VALUE PACK</div>
        <div class="boxes"><span></span><span></span><span></span></div>
      </div>
    </div>

    <div class="col-right">
      <div class="info">
        <div class="cat">VALUE PACK</div>
        <h1 class="name">{{ product.title }}</h1>
        <div class="price">{{ product.price | money }}<small>税込・3個入り／1個あたり {{ product.price | divided_by: 3 | money }}</small></div>
        <span class="save">単品3個（{{ single3 | money }}）より約{{ saveamt | money }}おトク</span>
        <p class="desc">{{ section.settings.desc }}</p>
        {%- form 'product', product, id: 'vpForm' -%}
          <input type="hidden" name="id" id="vpVid" value="{{ product.selected_or_first_available_variant.id }}">
          <div class="pick-h">味を選ぶ</div>
          <div class="flavors" id="vpFlavors">
            {%- for variant in product.variants -%}
              {%- assign vc = 'E99980' -%}
              {%- if variant.title contains '柚子' -%}{%- assign vc = 'A3CC44' -%}
              {%- elsif variant.title contains '牡蠣' or variant.title contains 'ココナッツ' -%}{%- assign vc = 'F2C645' -%}
              {%- endif -%}
              <button type="button" class="flavor{% if forloop.first %} active{% endif %}" data-vid="{{ variant.id }}" data-color="{{ vc }}"{% unless variant.available %} disabled{% endunless %}>{{ variant.title }}{% unless variant.available %}（在庫なし）{% endunless %}</button>
            {%- endfor -%}
          </div>
          <button type="submit" class="cart-btn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
            カートに入れる
          </button>
        {%- endform -%}
        <p class="note">同じ味が3個届きます。まとめ買い・ストックにどうぞ。<br>3種を食べ比べたい方は <a href="/products/tasting-set">食べ比べセット</a> もご用意しています。</p>
      </div>

      <div class="flavors-sec">
        <div class="sec-head">
          <div class="en">3 Flavors</div>
          <div class="jp">選べる、3つの味</div>
        </div>
        <div class="flist">
          <div class="fitem">
            <div class="sw" style="background:#E99980"></div>
            <div class="ftx"><div class="fnm">肉じゃがカレー</div><div class="fds">定番の家庭料理を、32種スパイスと直火焙煎ルウで。あ！となる中辛。</div><a class="flk" href="/products/acurry-nikujaga-single">SINGLE →</a></div>
          </div>
          <div class="fitem">
            <div class="sw" style="background:#A3CC44"></div>
            <div class="ftx"><div class="fnm">柚子胡椒プリプリ豚カレー</div><div class="fds">和のスパイス柚子胡椒と、プリプリの国産豚軟骨。爽やかなちょい辛。</div><a class="flk" href="/products/acurry-yuzu-single">SINGLE →</a></div>
          </div>
          <div class="fitem">
            <div class="sw" style="background:#F2C645"></div>
            <div class="ftx"><div class="fnm">牡蠣とココナッツのスープカレー</div><div class="fds">海のミルクと、ヤシのミルク。濃厚な旨みをやさしく包む中辛。</div><a class="flk" href="/products/acurry-kaki-single">SINGLE →</a></div>
          </div>
        </div>
      </div>

      <div class="eat">
        <div class="eat-head">
          <div class="en">How to Eat</div>
          <div class="jp">3ステップで、あ！</div>
        </div>
        <div class="steps">
          <div class="step"><div class="num en">01</div><div><div class="st">温める</div><div class="sd">袋のまま熱湯で5〜7分。電子レンジは中身を耐熱容器に移しラップをかけ、500Wで約2分温めます。</div></div></div>
          <div class="step"><div class="num en">02</div><div><div class="st">かける</div><div class="sd">炊きたてのごはんにたっぷりと。お好みでルウとごはんは別皿にしても。</div></div></div>
          <div class="step"><div class="num en">03</div><div><div class="st">味わう</div><div class="sd">一口目の「あ！」を、ぜひ。仕上げのトッピングは味によっておすすめが変わります。</div></div></div>
        </div>
      </div>
    </div>
  </section>

  <section class="other">
    <div class="other-head">
      <div class="en">Other Curry</div>
      <div class="jp">ほかの「あ！」</div>
    </div>
    {%- if product.collections.size > 0 -%}{%- assign relcol = product.collections.first -%}{%- else -%}{%- assign relcol = collections.all -%}{%- endif -%}
    <div class="other-grid">
      {%- assign shown = 0 -%}
      {%- for p in relcol.products -%}
        {%- if p.id != product.id and shown < 3 -%}
          {%- assign shown = shown | plus: 1 -%}
          {%- assign rkey = 'A3CC44' -%}
          {%- if p.title contains '肉じゃが' -%}{%- assign rkey = 'E99980' -%}{%- elsif p.title contains '牡蠣' or p.title contains 'ココナッツ' -%}{%- assign rkey = 'F2C645' -%}{%- elsif p.title contains 'ギフト' or p.title contains '食べ比べ' -%}{%- assign rkey = 'c9a24f' -%}{%- endif -%}
          <a class="other-card" href="{{ p.url }}">
            <div class="oimg" style="background:#{{ rkey }}">{% if p.featured_image %}<img src="{{ p.featured_image | image_url: width: 700 }}" alt="{{ p.title | escape }}">{% else %}商品写真{% endif %}</div>
            <div class="onm">{{ p.title }}</div>
            <div class="opr">{{ p.price | money }}</div>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>

</section>
<script>
(function(){
  var root=document.getElementById('acuvp'); if(!root) return;
  var vid=root.querySelector('#vpVid'), visual=root.querySelector('#vpVisual');
  var first=root.querySelector('.flavor'); if(first&&first.dataset.color){visual.style.background='#'+first.dataset.color;}
  root.querySelectorAll('.flavor').forEach(function(btn){
    btn.addEventListener('click',function(){
      if(btn.hasAttribute('disabled')) return;
      root.querySelectorAll('.flavor').forEach(function(b){b.classList.remove('active');});
      btn.classList.add('active');
      if(vid) vid.value=btn.dataset.vid;
      if(btn.dataset.color) visual.style.background='#'+btn.dataset.color;
    });
  });
})();
</script>
{% schema %}
{
  "name": "A CURRY バリューパック",
  "settings": [
    { "type": "textarea", "id": "desc", "label": "説明文", "default": "お気に入りの味を、3個まとめて。1個あたりが少しおトクになる、ストック向けのまとめ買いパックです。まずは気に入った一皿を、切らさないように。" }
  ],
  "presets": [{ "name": "A CURRY バリューパック" }]
}
{% endschema %}
