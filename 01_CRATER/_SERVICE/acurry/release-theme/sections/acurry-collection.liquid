{%- comment -%} A CURRY 商品一覧（コレクション）Pencil準拠・グレー基調 {%- endcomment -%}
<style>
  .acu-col{background:#b3b3b3;}
  /* ヒーロー */
  .acu-col__hero{background:#b3b3b3;padding:72px 64px 56px;}
  .acu-col__crumb{font-family:var(--acu-en);font-size:12px;font-weight:600;letter-spacing:3px;color:#33333399;margin-bottom:14px;}
  .acu-col__title{font-family:var(--acu-en);font-weight:600;font-size:clamp(48px,7vw,72px);letter-spacing:1px;color:var(--acu-ink);line-height:1.16;margin:0 0 24px;padding-bottom:.06em;}
  .acu-col__jp{font-family:var(--acu-jp);font-size:14px;font-weight:600;letter-spacing:2px;color:#444;margin:0;}
  /* ツールバー */
  .acu-col__bar{display:flex;justify-content:space-between;align-items:center;padding:24px 64px;background:#b3b3b3;}
  .acu-col__count{font-family:var(--acu-en);font-size:14px;letter-spacing:1px;color:var(--acu-ink);}
  .acu-col__sort{display:flex;align-items:center;gap:8px;font-family:var(--acu-jp);font-size:13px;color:#555;}
  .acu-col__sort select{border:0;background:transparent;font-family:var(--acu-jp);font-size:13px;color:#555;cursor:pointer;}
  /* グリッド */
  .acu-col__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;padding:64px 64px 88px;}
  .acu-col__card{display:block;text-decoration:none;color:inherit;}
  .acu-col__img{width:100%;aspect-ratio:3/4;border-radius:8px;overflow:hidden;display:flex;align-items:center;justify-content:center;}
  .acu-col__img img{width:100%;height:100%;object-fit:cover;display:block;}
  .acu-col__ph{font-family:var(--acu-jp);font-size:12px;letter-spacing:3px;color:#ffffffcc;}
  .acu-col__nm{font-family:var(--acu-jp);font-weight:600;font-size:18px;color:var(--acu-ink);margin:14px 0 4px;}
  .acu-col__pr{font-family:var(--acu-jp);font-size:15px;color:#555;}
  @media(max-width:768px){
    .acu-col__hero{padding:56px 32px 40px;}
    .acu-col__bar{padding:18px 32px;}
    .acu-col__grid{grid-template-columns:1fr;gap:36px;padding:48px 32px 64px;}
  }
</style>
<section class="acu acu-col">
  <div class="acu-col__hero">
    <div class="acu-col__crumb">HOME / SHOP</div>
    <h1 class="acu-col__title">{{ section.settings.title | default: 'Shop' }}</h1>
    <p class="acu-col__jp">{{ section.settings.subheading }}</p>
  </div>

  <div class="acu-col__bar">
    <div class="acu-col__count">{{ collection.products_count }} {% if collection.products_count == 1 %}product{% else %}products{% endif %}</div>
    <div class="acu-col__sort">
      <label for="acuSort">並び替え</label>
      <select id="acuSort" onchange="if(this.value){window.location.href=this.value}">
        {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
        {%- for option in collection.sort_options -%}
          <option value="{{ collection.url }}?sort_by={{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>
        {%- endfor -%}
      </select>
    </div>
  </div>

  <div class="acu-col__grid">
    {%- for product in collection.products -%}
      {%- comment -%} ダミー色はタイトル判定（並び順に依存しない）。肉じゃが/セット=サーモン、柚子=グリーン、牡蠣ココナッツ=イエロー {%- endcomment -%}
      {%- assign t = product.title -%}
      {%- assign keycolor = 'E99980' -%}
      {%- if t contains '柚子' -%}
        {%- assign keycolor = 'A3CC44' -%}
      {%- elsif t contains '牡蠣' or t contains 'ココナッツ' -%}
        {%- assign keycolor = 'F2C645' -%}
      {%- elsif t contains 'ギフト' or t contains 'バリュー' or t contains '食べ比べ' -%}
        {%- assign keycolor = 'c9a24f' -%}
      {%- endif -%}
      <a class="acu-col__card" href="{{ product.url }}">
        <div class="acu-col__img" style="{% unless product.featured_image %}background:#{{ keycolor }};{% endunless %}">
          {%- if product.featured_image -%}
            <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}" loading="lazy">
          {%- else -%}
            <span class="acu-col__ph">商品写真</span>
          {%- endif -%}
        </div>
        <div class="acu-col__nm">{{ product.title }}</div>
        <div class="acu-col__pr">{{ product.price | money }}</div>
      </a>
    {%- else -%}
      <p class="acu-col__jp">商品がありません。</p>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "A CURRY Collection",
  "settings": [
    { "type": "text", "id": "title", "label": "見出し(英語)", "default": "Shop" },
    { "type": "text", "id": "subheading", "label": "サブ(日本語)", "default": "全商品 ・ 3種の「あ！」" }
  ],
  "presets": [{ "name": "A CURRY Collection" }]
}
{% endschema %}
