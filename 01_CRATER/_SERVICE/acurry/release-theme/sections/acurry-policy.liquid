{%- comment -%} A CURRY 長文ポリシー（プライバシー／利用規約／返品など。見出し＋本文のブロック積み） {%- endcomment -%}
<style>
  .acu-pol{background:var(--acu-paper);padding:96px 64px;}
  .acu-pol__inner{max-width:820px;margin:0 auto;}
  .acu-pol__eyebrow{font-family:var(--acu-en);font-size:12px;letter-spacing:3px;color:var(--acu-sub);}
  .acu-pol__t{font-family:var(--acu-en);font-weight:600;font-size:clamp(38px,5vw,60px);color:var(--acu-ink);line-height:1.05;margin:10px 0 6px;}
  .acu-pol__jp{font-family:var(--acu-jp);font-weight:600;font-size:14px;letter-spacing:2px;color:#555;}
  .acu-pol__intro{font-family:var(--acu-jp);font-size:15px;line-height:1.95;color:#444;margin:32px 0 0;}
  .acu-pol__sec{margin-top:44px;}
  .acu-pol__h{font-family:var(--acu-jp)!important;font-weight:600;font-size:18px;color:var(--acu-ink);margin:0 0 14px;line-height:1.5;}
  .acu-pol__body{font-family:var(--acu-jp);font-size:15px;line-height:1.95;color:#444;margin:0;}
  .acu-pol__body a{color:var(--acu-ink);}
  .acu-pol__date{font-family:var(--acu-jp);font-size:13px;color:#666;margin-top:56px;text-align:right;}
  @media(max-width:768px){
    .acu-pol{padding:64px 32px;}
    .acu-pol__sec{margin-top:36px;}
  }
</style>
<section class="acu acu-pol">
  <div class="acu-pol__inner">
    <div class="acu-pol__head">
      {%- if section.settings.eyebrow != blank -%}<div class="acu-pol__eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
      <h1 class="acu-pol__t">{{ section.settings.heading }}</h1>
      {%- if section.settings.subheading != blank -%}<div class="acu-pol__jp">{{ section.settings.subheading }}</div>{%- endif -%}
    </div>
    {%- if section.settings.intro != blank -%}<p class="acu-pol__intro">{{ section.settings.intro | newline_to_br }}</p>{%- endif -%}
    {%- for block in section.blocks -%}
      <section class="acu-pol__sec" {{ block.shopify_attributes }}>
        {%- if block.settings.heading != blank -%}<h2 class="acu-pol__h">{{ block.settings.heading }}</h2>{%- endif -%}
        <div class="acu-pol__body">{{ block.settings.body | newline_to_br }}</div>
      </section>
    {%- endfor -%}
    {%- if section.settings.revised != blank -%}<div class="acu-pol__date">{{ section.settings.revised }}</div>{%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "A CURRY ポリシー",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "英字ラベル", "default": "POLICY" },
    { "type": "text", "id": "heading", "label": "見出し(英)", "default": "Policy" },
    { "type": "text", "id": "subheading", "label": "見出し(日)", "default": "ポリシー" },
    { "type": "textarea", "id": "intro", "label": "導入文" },
    { "type": "text", "id": "revised", "label": "制定・改定日" }
  ],
  "blocks": [
    { "type": "section", "name": "見出し＋本文", "settings": [
      { "type": "text", "id": "heading", "label": "小見出し", "default": "見出し" },
      { "type": "textarea", "id": "body", "label": "本文", "default": "本文を入力してください。" }
    ]}
  ]
}
{% endschema %}
