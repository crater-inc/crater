{%- comment -%} A CURRY お問い合わせ（左：案内、右：Shopifyコンタクトフォーム） {%- endcomment -%}
<style>
  .acu-ct{background:var(--acu-paper);padding:96px 64px;}
  .acu-ct__inner{max-width:1080px;margin:0 auto;}
  .acu-ct__eyebrow{font-family:var(--acu-en);font-size:12px;letter-spacing:3px;color:var(--acu-sub);}
  .acu-ct__t{font-family:var(--acu-en);font-weight:600;font-size:clamp(38px,5vw,60px);color:var(--acu-ink);line-height:1.05;margin:10px 0 6px;}
  .acu-ct__jp{font-family:var(--acu-jp);font-weight:600;font-size:14px;letter-spacing:2px;color:#555;}
  .acu-ct__grid{display:grid;grid-template-columns:320px minmax(0,1fr);gap:64px;margin-top:56px;align-items:start;}
  .acu-ct__info p{font-family:var(--acu-jp);font-size:15px;line-height:1.95;color:#444;margin:0 0 28px;}
  .acu-ct__info .lb{font-family:var(--acu-en);font-size:11px;letter-spacing:2px;color:var(--acu-sub);display:block;margin-bottom:6px;}
  .acu-ct__info a{color:var(--acu-ink);}
  .acu-ct__field{display:flex;flex-direction:column;gap:8px;margin-bottom:22px;}
  .acu-ct__field label{font-family:var(--acu-jp);font-size:13px;font-weight:600;color:#333;}
  .acu-ct__field input,.acu-ct__field textarea{
    font-family:var(--acu-jp);font-size:16px;color:#1a1a1a;background:#fff;
    border:1px solid var(--acu-line);border-radius:6px;padding:14px 16px;width:100%;box-sizing:border-box;outline:none;transition:border-color .2s;}
  .acu-ct__field input:focus,.acu-ct__field textarea:focus{border-color:var(--acu-ink);}
  .acu-ct__field textarea{min-height:160px;resize:vertical;line-height:1.7;}
  .acu-ct__row2{display:grid;grid-template-columns:1fr 1fr;gap:22px;}
  .acu-ct__submit{border:0;border-radius:8px;background:#111;color:#f7f4ef;height:56px;padding:0 40px;
    font-family:var(--acu-jp);font-size:15px;font-weight:600;letter-spacing:1px;cursor:pointer;transition:background .2s;}
  .acu-ct__submit:hover{background:#000;}
  .acu-ct__note{font-family:var(--acu-jp);font-size:12.5px;line-height:1.8;color:#666;margin-top:16px;}
  .acu-ct__ok{background:#eef3e4;border:1px solid #cddba9;border-radius:8px;padding:20px 22px;
    font-family:var(--acu-jp);font-size:14px;line-height:1.8;color:#3a4a1e;margin-bottom:28px;}
  @media(max-width:860px){
    .acu-ct{padding:64px 32px;}
    .acu-ct__grid{grid-template-columns:1fr;gap:40px;}
    .acu-ct__row2{grid-template-columns:1fr;}
  }
</style>
<section class="acu acu-ct">
  <div class="acu-ct__inner">
    <div class="acu-ct__head">
      {%- if section.settings.eyebrow != blank -%}<div class="acu-ct__eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
      <h1 class="acu-ct__t">{{ section.settings.heading }}</h1>
      {%- if section.settings.subheading != blank -%}<div class="acu-ct__jp">{{ section.settings.subheading }}</div>{%- endif -%}
    </div>
    <div class="acu-ct__grid">
      <div class="acu-ct__info">
        {%- if section.settings.lead != blank -%}<p>{{ section.settings.lead | newline_to_br }}</p>{%- endif -%}
        {%- if section.settings.email != blank -%}<p><span class="lb">EMAIL</span><a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></p>{%- endif -%}
        {%- if section.settings.tel != blank -%}<p><span class="lb">TEL</span>{{ section.settings.tel }}</p>{%- endif -%}
        {%- if section.settings.hours != blank -%}<p><span class="lb">HOURS</span>{{ section.settings.hours | newline_to_br }}</p>{%- endif -%}
        {%- if section.settings.address != blank -%}<p><span class="lb">ADDRESS</span>{{ section.settings.address | newline_to_br }}</p>{%- endif -%}
      </div>
      <div class="acu-ct__form">
        {%- if form.posted_successfully? -%}
          <div class="acu-ct__ok">お問い合わせありがとうございます。内容を確認のうえ、担当者よりご連絡いたします。</div>
        {%- endif -%}
        {%- form 'contact' -%}
          {%- if form.errors -%}
            <div class="acu-ct__ok" style="background:#f7e9e6;border-color:#e0b3a9;color:#7a2e1e;">入力内容をご確認ください：{{ form.errors | default_errors }}</div>
          {%- endif -%}
          <div class="acu-ct__row2">
            <div class="acu-ct__field">
              <label for="acu-ct-name">お名前</label>
              <input id="acu-ct-name" type="text" name="contact[name]" value="{{ form.name }}" required>
            </div>
            <div class="acu-ct__field">
              <label for="acu-ct-email">メールアドレス</label>
              <input id="acu-ct-email" type="email" name="contact[email]" value="{{ form.email }}" required>
            </div>
          </div>
          <div class="acu-ct__field">
            <label for="acu-ct-subject">件名</label>
            <input id="acu-ct-subject" type="text" name="contact[件名]">
          </div>
          <div class="acu-ct__field">
            <label for="acu-ct-body">お問い合わせ内容</label>
            <textarea id="acu-ct-body" name="contact[body]" required>{{ form.body }}</textarea>
          </div>
          <button class="acu-ct__submit" type="submit">送信する</button>
          <p class="acu-ct__note">{{ section.settings.note }}</p>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "A CURRY お問い合わせ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "英字ラベル", "default": "CONTACT" },
    { "type": "text", "id": "heading", "label": "見出し(英)", "default": "Contact" },
    { "type": "text", "id": "subheading", "label": "見出し(日)", "default": "お問い合わせ" },
    { "type": "textarea", "id": "lead", "label": "案内文", "default": "商品・ご注文・その他ご不明な点がございましたら、下記フォームよりお気軽にお問い合わせください。" },
    { "type": "text", "id": "email", "label": "メールアドレス" },
    { "type": "text", "id": "tel", "label": "電話番号" },
    { "type": "textarea", "id": "hours", "label": "受付時間" },
    { "type": "textarea", "id": "address", "label": "住所" },
    { "type": "textarea", "id": "note", "label": "フォーム下の注記", "default": "通常2〜3営業日以内にご返信いたします。数日経っても返信がない場合は、迷惑メールフォルダをご確認ください。" }
  ]
}
{% endschema %}
