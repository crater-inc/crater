{%- comment -%} A CURRY ジャーナル一覧（ブログページ）柚子デザイン基準 {%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Noto+Serif+JP:wght@500;600;700&family=Noto+Sans+JP:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  #acu-jl{--ink:#1a1a1a;--sub:#555;--meta:#888;--line:#0000001a;--bg:#b3b3b3;}
  #acu-jl *{margin:0;padding:0;box-sizing:border-box;}
  #acu-jl{font-family:'Noto Sans JP',sans-serif;color:var(--ink);background:var(--bg);line-height:1.7;overflow-x:clip;-webkit-font-smoothing:antialiased;}
  #acu-jl a{color:inherit;text-decoration:none;}
  #acu-jl img{max-width:100%;display:block;}
  #acu-jl .en{font-family:'Playfair Display',serif;}
  /* ヒーロー */
  #acu-jl .hero{max-width:1440px;margin:0 auto;padding:72px 48px 44px;}
  #acu-jl .crumb{font-family:'Playfair Display',serif;font-size:12px;letter-spacing:2px;color:#000;margin-bottom:16px;}
  #acu-jl .crumb a:hover{text-decoration:underline;}
  #acu-jl .htitle{font-family:'Playfair Display',serif;font-weight:600;font-size:clamp(48px,7vw,72px);letter-spacing:1px;color:var(--ink);line-height:1.16;padding-bottom:.06em;}
  #acu-jl .hjp{font-family:'Noto Sans JP',sans-serif;font-size:14px;font-weight:600;letter-spacing:2px;color:#444;margin-top:4px;}
  /* グリッド */
  #acu-jl .grid{max-width:1440px;margin:0 auto;padding:20px 48px 40px;display:grid;grid-template-columns:repeat(3,1fr);gap:44px 28px;}
  #acu-jl .card{display:block;}
  #acu-jl .card .im{width:100%;aspect-ratio:16/10;border-radius:8px;overflow:hidden;background:linear-gradient(135deg,#d6d6d6,#aeaeae);}
  #acu-jl .card .im img{width:100%;height:100%;object-fit:cover;}
  #acu-jl .card .dt{font-family:'Playfair Display',serif;font-size:14px;letter-spacing:1px;color:var(--sub);margin:16px 0 6px;}
  #acu-jl .card .ti{font-family:'Noto Sans JP',sans-serif;font-weight:600;font-size:17px;line-height:1.5;color:var(--ink);}
  #acu-jl .card .ex{font-size:14px;line-height:1.75;color:#666;margin-top:8px;}
  #acu-jl .card .mo{display:inline-block;margin-top:16px;font-family:'Playfair Display',serif;font-size:12px;letter-spacing:2px;color:var(--ink);border-bottom:1px solid var(--ink);padding-bottom:5px;}
  #acu-jl .card:hover .mo{opacity:.6;}
  #acu-jl .empty{max-width:1440px;margin:0 auto;padding:0 48px 80px;font-size:15px;color:#444;}
  /* ページャ */
  #acu-jl .pager{max-width:1440px;margin:0 auto;padding:24px 48px 96px;display:flex;justify-content:center;align-items:center;gap:10px;}
  #acu-jl .pager a,#acu-jl .pager span{font-family:'Playfair Display',serif;font-size:14px;min-width:40px;height:40px;display:flex;align-items:center;justify-content:center;border-radius:6px;color:var(--ink);}
  #acu-jl .pager a{border:1px solid #00000022;}
  #acu-jl .pager a:hover{background:#00000010;}
  #acu-jl .pager .cur{background:#111;color:#f7f4ef;}
  #acu-jl .pager .gap{border:none;}
  @media(max-width:768px){
    #acu-jl .hero{padding:56px 32px 32px;}
    #acu-jl .grid{grid-template-columns:1fr;gap:36px;padding:12px 32px 32px;}
    #acu-jl .pager{padding:16px 32px 72px;}
  }
</style>
<section id="acu-jl">
  <div class="hero">
    <div class="crumb"><a href="{{ routes.root_url }}">HOME</a> / JOURNAL</div>
    <h1 class="htitle">{{ section.settings.heading | default: 'Journal' }}</h1>
    <div class="hjp">{{ section.settings.subheading | default: 'カレーは、読みもの。' }}</div>
  </div>

  {%- paginate blog.articles by 9 -%}
    {%- if blog.articles_count > 0 -%}
      <div class="grid">
        {%- for article in blog.articles -%}
          <a class="card" href="{{ article.url }}">
            <div class="im">
              {%- if article.image -%}<img src="{{ article.image | image_url: width: 800 }}" alt="{{ article.title | escape }}" loading="lazy">
              {%- else -%}<img src="{{ 'acurry-dummy-product.jpg' | asset_url }}" alt="" loading="lazy">{%- endif -%}
            </div>
            <div class="dt">{{ article.published_at | date: '%Y.%m.%d' }}</div>
            <div class="ti">{{ article.title }}</div>
            {%- if article.excerpt != blank -%}<div class="ex">{{ article.excerpt | strip_html | truncate: 64 }}</div>{%- endif -%}
            <span class="mo">READ MORE</span>
          </a>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="pager" role="navigation">
          {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">‹</a>{%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>
            {%- elsif part.title == paginate.current_page -%}<span class="cur">{{ part.title }}</span>
            {%- else -%}<span class="gap">{{ part.title }}</span>{%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}<a href="{{ paginate.next.url }}">›</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- else -%}
      <p class="empty">記事はまだありません。近日公開予定です。</p>
    {%- endif -%}
  {%- endpaginate -%}
</section>
{% schema %}
{
  "name": "A CURRY Journal 一覧",
  "settings": [
    { "type": "text", "id": "heading", "label": "見出し(英語)", "default": "Journal" },
    { "type": "text", "id": "subheading", "label": "サブ(日本語)", "default": "カレーは、読みもの。" }
  ],
  "presets": [{ "name": "A CURRY Journal 一覧" }]
}
{% endschema %}
