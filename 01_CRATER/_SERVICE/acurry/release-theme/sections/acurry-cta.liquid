{%- comment -%} A CURRY 締めの大バナー {%- endcomment -%}
<style>
  .acu-cta{background:linear-gradient(160deg,#969696,#7c7c7c);color:#1a1a1a;
    text-align:center;padding:100px 60px;display:flex;flex-direction:column;align-items:center;gap:22px;}
  .acu .acu-cta__t{font-family:'Noto Serif JP',serif!important;font-weight:600;color:#1a1a1a!important;font-size:clamp(34px,4.2vw,52px);margin:0;line-height:1.4;letter-spacing:.04em;}
  .acu-cta__jp{font-family:var(--acu-jp);font-size:15px;letter-spacing:2px;color:#333333;}
  .acu-cta__btn{margin-top:6px;border:1px solid #1a1a1a;border-radius:30px;padding:16px 50px;
    color:#1a1a1a;text-decoration:none;font-family:var(--acu-en);font-size:13px;letter-spacing:2px;transition:.3s;}
  .acu-cta__btn:hover{background:#1a1a1a;color:#fff;}
  @media(max-width:768px){.acu-cta{padding:72px 32px;}}
</style>
<section class="acu acu-cta">
  <h2 class="acu-cta__t">{{ section.settings.heading }}</h2>
  {%- if section.settings.subheading != blank -%}<div class="acu-cta__jp">{{ section.settings.subheading }}</div>{%- endif -%}
  {%- if section.settings.button_label != blank -%}
    <a class="acu-cta__btn" href="{{ section.settings.button_link | default: '/collections/all' }}">{{ section.settings.button_label }}</a>
  {%- endif -%}
</section>
{% schema %}
{
  "name": "A CURRY CTA",
  "settings": [
    { "type": "text", "id": "heading", "label": "見出し", "default": "あ！を今日の食卓に。" },
    { "type": "text", "id": "subheading", "label": "サブ(日本語)", "default": "いつものごはんに、小さな驚きをひとつ。" },
    { "type": "text", "id": "button_label", "label": "ボタン", "default": "SHOP NOW" },
    { "type": "url", "id": "button_link", "label": "リンク" }
  ],
  "presets": [{ "name": "A CURRY CTA" }]
}
{% endschema %}
