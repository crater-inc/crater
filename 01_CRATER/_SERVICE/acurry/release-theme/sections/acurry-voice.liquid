{%- comment -%} A CURRY お客様の声 {%- endcomment -%}
<style>
  .acu-voice{background:#363636;padding:84px 64px;}
  .acu-voice__t{font-family:var(--acu-en);font-weight:600;font-size:clamp(40px,5vw,64px);color:var(--acu-white)!important;margin:0;line-height:1;}
  .acu-voice__jp{font-family:var(--acu-jp);font-weight:600;font-size:13px;letter-spacing:3px;color:#f7f4ef99;margin:8px 0 40px;}
  .acu-voice__row{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;}
  .acu-voice__card{background:#fff;padding:32px;border-radius:4px;display:flex;flex-direction:column;gap:14px;}
  .acu-voice__star{font-size:15px;letter-spacing:2px;color:#F2C645;}
  .acu-voice__ct{font-family:var(--acu-en);font-size:17px;color:var(--acu-ink);margin:0;}
  .acu-voice__cq{font-family:var(--acu-jp);font-size:14px;line-height:1.8;color:#555;margin:0;}
  @media(max-width:768px){.acu-voice{padding:56px 32px;}.acu-voice__row{grid-template-columns:1fr;}}
</style>
<section class="acu acu-voice">
  <h2 class="acu-voice__t">{{ section.settings.heading }}</h2>
  <div class="acu-voice__jp">{{ section.settings.subheading }}</div>
  <div class="acu-voice__row">
    {%- for block in section.blocks -%}
      <div class="acu-voice__card" {{ block.shopify_attributes }}>
        <div class="acu-voice__star">★★★★★</div>
        <p class="acu-voice__ct">{{ block.settings.title }}</p>
        <p class="acu-voice__cq">{{ block.settings.quote }}</p>
      </div>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "A CURRY Voice",
  "settings": [
    { "type": "text", "id": "heading", "label": "見出し(英語)", "default": "Customer Voice" },
    { "type": "text", "id": "subheading", "label": "サブ(日本語)", "default": "お客様の声" }
  ],
  "blocks": [
    { "type": "voice", "name": "声", "settings": [
      { "type": "text", "id": "title", "label": "タイトル", "default": "また食べたくなる味" },
      { "type": "textarea", "id": "quote", "label": "本文", "default": "忙しい日の救世主。でも手抜きに見えないのが嬉しい。" }
    ]}
  ],
  "presets": [{
    "name": "A CURRY Voice",
    "blocks": [
      { "type": "voice", "settings": { "title": "また食べたくなる味", "quote": "忙しい日の救世主。でも手抜きに見えないのが嬉しい。" } },
      { "type": "voice", "settings": { "title": "贈って喜ばれた", "quote": "パッケージも素敵で、ギフトにぴったりでした。" } },
      { "type": "voice", "settings": { "title": "記憶に残る一皿", "quote": "名前の通り、食べたあともずっと余韻が残る味。" } }
    ]
  }]
}
{% endschema %}
