{%- comment -%} EC テンプレ イチオシ深掘り（テキスト左／画像右） {%- endcomment -%}
<style>
  .ec-pick{display:grid;grid-template-columns:1fr 1fr;background:var(--ec-paper);}
  .ec-pick__body{display:flex;flex-direction:column;justify-content:center;gap:16px;padding:64px 72px;}
  .ec-pick__t{font-family:var(--ec-en);font-weight:600;font-size:clamp(40px,5vw,64px);color:var(--ec-ink);margin:0;line-height:1;}
  .ec-pick__sub{font-family:var(--ec-jp);font-weight:600;font-size:clamp(20px,2.4vw,28px);color:var(--ec-ink);margin:0;}
  .ec-pick__d{font-family:var(--ec-jp);font-size:15px;line-height:1.9;color:#444;margin:0;}
  .ec-pick__btn{margin-top:6px;width:max-content;border:1px solid var(--ec-ink);border-radius:30px;padding:14px 36px;
    color:var(--ec-ink);text-decoration:none;font-family:var(--ec-en);font-size:12px;letter-spacing:2px;transition:.3s;}
  .ec-pick__btn:hover{background:var(--ec-ink);color:#fff;}
  .ec-pick__img{position:relative;min-height:560px;background:linear-gradient(135deg,#d6d6d6,#aeaeae);overflow:hidden;}
  .ec-pick__img img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:1!important;}
  @media(max-width:768px){.ec-pick{grid-template-columns:1fr;}.ec-pick__img{min-height:300px;order:-1;}.ec-pick__body{padding:48px 32px;}}
</style>
<section class="ec ec-pick">
  <div class="ec-pick__body">
    <h2 class="ec-pick__t">{{ section.settings.heading }}</h2>
    {%- if section.settings.subheading != blank -%}<div class="ec-pick__sub">{{ section.settings.subheading }}</div>{%- endif -%}
    <p class="ec-pick__d">{{ section.settings.body }}</p>
    {%- if section.settings.button_label != blank -%}
      <a class="ec-pick__btn" href="{{ section.settings.button_link | default: '/collections/all' }}">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
  <div class="ec-pick__img">{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 1200 }}" alt="" loading="lazy">{%- else -%}<img src="{{ 'ec-dummy-alt.jpg' | asset_url }}" alt="" loading="lazy">{%- endif -%}</div>
</section>
{% schema %}
{
  "name": "EC Pick Up",
  "settings": [
    { "type": "text", "id": "heading", "label": "見出し(英語)", "default": "Pick Up" },
    { "type": "image_picker", "id": "image", "label": "画像（未設定＝グレーのダミー）" },
    { "type": "text", "id": "subheading", "label": "商品名(日本語)", "default": "商品名が入ります" },
    { "type": "textarea", "id": "body", "label": "本文", "default": "イチオシ商品の魅力を、ここで深掘りして伝えます。特徴・こだわり・使い方などを自由に記載できます。" },
    { "type": "text", "id": "button_label", "label": "ボタン", "default": "VIEW DETAILS" },
    { "type": "url", "id": "button_link", "label": "リンク（未設定＝全商品へ）" }
  ],
  "presets": [{ "name": "EC Pick Up" }]
}
{% endschema %}
