{%- comment -%} EC テンプレ 商品一覧（コレクション）グレー基調 {%- endcomment -%}
<style>
  .ec-col{background:#a6a6a6;}
  /* ヒーロー */
  .ec-col__hero{background:#a6a6a6;padding:72px 64px 56px;}
  .ec-col__crumb{font-family:var(--ec-en);font-size:12px;font-weight:600;letter-spacing:3px;color:#33333399;margin-bottom:14px;}
  .ec-col__title{font-family:var(--ec-en);font-weight:600;font-size:clamp(48px,7vw,72px);letter-spacing:1px;color:var(--ec-ink);line-height:1;margin:0 0 14px;}
  .ec-col__jp{font-family:var(--ec-jp);font-size:14px;font-weight:600;letter-spacing:2px;color:#444;margin:0;}
  /* ツールバー */
  .ec-col__bar{display:flex;justify-content:space-between;align-items:center;padding:24px 64px;background:#a6a6a6;}
  .ec-col__count{font-family:var(--ec-en);font-size:14px;letter-spacing:1px;color:var(--ec-ink);}
  .ec-col__sort{display:flex;align-items:center;gap:8px;font-family:var(--ec-jp);font-size:13px;color:#555;}
  .ec-col__sort select{border:0;background:transparent;font-family:var(--ec-jp);font-size:13px;color:#555;cursor:pointer;}
  /* グリッド */
  .ec-col__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;padding:64px 64px 88px;}
  .ec-col__card{display:block;text-decoration:none;color:inherit;}
  .ec-col__img{width:100%;aspect-ratio:3/4;border-radius:8px;overflow:hidden;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#d6d6d6,#aeaeae);}
  .ec-col__img img{width:100%;height:100%;object-fit:cover;display:block;}
  .ec-col__ph{font-family:var(--ec-jp);font-size:12px;letter-spacing:3px;color:#ffffffcc;}
  .ec-col__nm{font-family:var(--ec-jp);font-weight:600;font-size:18px;color:var(--ec-ink);margin:14px 0 4px;}
  .ec-col__pr{font-family:var(--ec-jp);font-size:15px;color:#555;}
  @media(max-width:768px){
    .ec-col__hero{padding:56px 32px 40px;}
    .ec-col__bar{padding:18px 32px;}
    .ec-col__grid{grid-template-columns:1fr;gap:36px;padding:48px 32px 64px;}
  }
</style>
<section class="ec ec-col">
  <div class="ec-col__hero">
    <div class="ec-col__crumb">HOME / SHOP</div>
    <h1 class="ec-col__title">{{ section.settings.title | default: 'Shop' }}</h1>
    <p class="ec-col__jp">{{ section.settings.subheading }}</p>
  </div>

  <div class="ec-col__bar">
    <div class="ec-col__count">{{ collection.products_count }} {% if collection.products_count == 1 %}product{% else %}products{% endif %}</div>
    <div class="ec-col__sort">
      <label for="ecSort">並び替え</label>
      <select id="ecSort" onchange="if(this.value){window.location.href=this.value}">
        {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
        {%- for option in collection.sort_options -%}
          <option value="{{ collection.url }}?sort_by={{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>
        {%- endfor -%}
      </select>
    </div>
  </div>

  <div class="ec-col__grid">
    {%- for product in collection.products -%}
      <a class="ec-col__card" href="{{ product.url }}">
        <div class="ec-col__img">
          {%- if product.featured_image -%}
            <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}" loading="lazy">
          {%- else -%}
            <span class="ec-col__ph">商品写真</span>
          {%- endif -%}
        </div>
        <div class="ec-col__nm">{{ product.title }}</div>
        <div class="ec-col__pr">{{ product.price | money }}</div>
      </a>
    {%- else -%}
      <p class="ec-col__jp">商品がありません。</p>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "EC Collection",
  "settings": [
    { "type": "text", "id": "title", "label": "見出し(英語)", "default": "Shop" },
    { "type": "text", "id": "subheading", "label": "サブ(日本語)", "default": "全商品" }
  ],
  "presets": [{ "name": "EC Collection" }]
}
{% endschema %}
