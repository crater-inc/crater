            {
              "type": "text",
              "id": "YjF89",
              "fill": "$ink",
              "content": "知られていなければ、\n存在しないのと同じ。",
              "lineHeight": 1.4,
              "fontFamily": "$font-jp",
              "fontSize": 52,
              "fontWeight": "800",
              "letterSpacing": -1
