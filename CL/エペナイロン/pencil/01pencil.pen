                      "id": "MJkKP",
                      "fill": "$epe-text-white",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Redefining",
                      "lineHeight": 1.15,
                      "fontFamily": "$epe-font-en",
                      "fontSize": 26,
                      "fontWeight": "300"
                    },
                    {
                      "type": "text",
                      "id": "GlQ7J",
                      "fill": "$epe-text-white",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "high specifications.",
                      "lineHeight": 1.15,
                      "fontFamily": "$epe-font-en",
                      "fontSize": 26,
                      "fontWeight": "700"
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "qT5mQ",
                  "fill": "$epe-text-white",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Overflowing pockets, excessive weight, ornamentation for the sake of design.\nAre these truly necessary in our daily lives in the city?\n\nWe realize it.\nIt's not high-spec, it's over-spec.\nepe pursues functional beauty born from subtraction.\n\nA streamlined design, stripped of the noise of the city.\nepe is now redefining the definition of high-spec.",
                  "lineHeight": 1.7,
                  "fontFamily": "$epe-font-en",
                  "fontSize": 12.5,
                  "fontWeight": "normal"
                }
              ]
            },
