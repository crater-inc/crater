              "children": [
                {
                  "type": "frame",
                  "id": "PcZ2G",
                  "name": "Headline",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 2,
                  "children": [
                    {
                      "type": "text",
                      "id": "q8QGSZ",
                      "name": "Line1",
                      "fill": "$epe-text-white",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Redefining",
                      "lineHeight": 1.15,
                      "fontFamily": "$epe-font-en",
                      "fontSize": 36,
                      "fontWeight": "300"
                    },
                    {
                      "type": "text",
                      "id": "H8uF67",
                      "name": "Line2",
                      "fill": "$epe-text-white",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "high specifications.",
                      "lineHeight": 1.15,
                      "fontFamily": "$epe-font-en",
                      "fontSize": 36,
                      "fontWeight": "700"
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "vcqgl",
                  "name": "Body",
                  "fill": "$epe-text-white",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Overflowing pockets, excessive weight, ornamentation for the sake of design.\nAre these truly necessary in our daily lives in the city?\n\nWe realize it.\nIt's not high-spec, it's over-spec.\nepe pursues functional beauty born from subtraction.\nThe optimal solution of durability and lightness, achieved through specially processed, high-density fabric.\n\nA streamlined design, stripped of the noise of the city.\nOnly what you truly need, in your hands.\nepe is now redefining the definition of high-spec.",
                  "lineHeight": 1.7,
                  "fontFamily": "$epe-font-en",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "S0oRS",
              "x": 88,
              "y": 725,
