<!doctype html>
{%- liquid
  assign rtl_attr = ''
  if request.locale.iso_code == 'ar' or request.locale.iso_code == 'he'
    assign rtl_attr = ' dir="rtl"'
  endif
-%}

<html class="no-js" lang="{{ request.locale.iso_code }}" {{ rtl_attr }}>
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- unless settings.type_heading_font.system? and settings.type_body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}

    {% render 'meta-tags' %}
    <script src="{{- 'swiper-bundle.min.js' | asset_url -}}" defer="defer"></script>
    <script src="{{- 'bodyScrollLock.min.js' | asset_url -}}" defer="defer"></script>
    <script src="{{- 'pubsub.js' | asset_url -}}" defer="defer"></script>
    <script src="{{- 'global.js' | asset_url -}}" defer="defer"></script>
    <noscript>
      <style>
        img[loading='lazy'] { opacity: 1; }
      </style>
    </noscript>
    <script src="{{ 'cookies.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}

    {%- render 'settings' -%}

    {{ 'base.css' | asset_url | stylesheet_tag }}

    {%- comment -%} === エペナイロン 専用フォント & デザイントークン（Pencil正: CL/エペナイロン/pencil/01pencil.pen 準拠） === {%- endcomment -%}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Noto+Sans+JP:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
      :root{
        --epe-section-bg:#3B393A; --epe-footer-bg:#000000;
        --epe-text-white:#FFFFFF; --epe-text-body:#E4E4E4; --epe-text-muted:#ADADAD;
        --epe-line:#6B6B6B; --epe-button-bg:#000000;
        --epe-img-placeholder:#C7C7C7; --epe-img-placeholder-dark:#4D4D4D;
        --epe-en:'Poppins', sans-serif; --epe-jp:'Noto Sans JP', 'Hiragino Kaku Gothic ProN', sans-serif;
      }
      /* === エペナイロン 全ページ共通タイポ：Releaseのフォント変数を上書き（商品一覧/詳細/カート等すべてに反映） === */
      :root{
        --font-heading-family:'Poppins','Noto Sans JP','Hiragino Kaku Gothic ProN',sans-serif;
        --font-body-family:'Noto Sans JP','Hiragino Kaku Gothic ProN',sans-serif;
        --font-button-family:'Poppins','Noto Sans JP','Hiragino Kaku Gothic ProN',sans-serif;
        --font-italic-family:'Poppins','Noto Sans JP',sans-serif;
      }
      /* === 全ページ共通：ダークな都市コンクリートトーン背景で統一（TOP以外も同じ） === */
      body{background:var(--epe-section-bg);}
      .content-for-layout{background:var(--epe-section-bg);}
      body.template--policy [class*="color-scheme-"],
      body.template--page:not(.template--about-us) [class*="color-scheme-"],
      body.template--404 [class*="color-scheme-"],
      body.template--search [class*="color-scheme-"],
      body.template--list-collections [class*="color-scheme-"],
      body.template--cart [class*="color-scheme-"],
      body[class*="template--customers"] [class*="color-scheme-"]{
        --color-background:59,57,58;
        --gradient-background:#3B393A;
        --color-foreground:255,255,255;
        --color-foreground-heading:255,255,255;
      }
      /* === エペナイロン 共通ページヒーロー（パンくず+タイトル）：Shop/Journal/Legal/Cart で共通使用 === */
      .epe-pagehero{padding:72px 80px 40px;}
      .epe-pagehero__crumb{font-family:var(--epe-en);font-size:12px;letter-spacing:2px;color:var(--epe-text-muted);margin-bottom:14px;}
      .epe-pagehero__crumb a{color:var(--epe-text-muted);text-decoration:none;}
      .epe-pagehero__crumb a:hover{color:var(--epe-text-white);}
      .epe-pagehero__title{font-family:var(--epe-en);font-weight:700;font-size:48px;color:var(--epe-text-white);margin:0 0 10px;line-height:1.15;}
      .epe-pagehero__sub{font-family:var(--epe-jp);font-size:14px;color:var(--epe-text-muted);margin:0;}
      @media(max-width:768px){
        .epe-pagehero{padding:48px 24px 28px;}
        .epe-pagehero__title{font-size:32px;}
      }
      .epe, .epe *{box-sizing:border-box;}
      .epe ::selection{background:var(--epe-text-white);color:var(--epe-section-bg);}
      /* === エペナイロン 共通コンポーネント：画像タイル（snippets/epe-image-card.liquid） === */
      .epe-imgcard{display:block;text-decoration:none;color:inherit;}
      .epe-imgcard__img{width:100%;aspect-ratio:16/9;background-color:var(--epe-img-placeholder);background-size:cover;background-position:center;}
      .epe-imgcard__name{font-family:var(--epe-jp);font-size:14px;color:var(--epe-text-white);margin-top:14px;}
      .epe-imgcard__price{font-family:var(--epe-en);font-size:13px;color:var(--epe-text-muted);margin-top:4px;}
      .epe-blogcard{display:flex;flex-direction:column;gap:14px;text-decoration:none;color:inherit;}
      .epe-blogcard__img{width:100%;aspect-ratio:16/9;background-color:var(--epe-img-placeholder);background-size:cover;background-position:center;}
      .epe-blogcard__date{font-family:var(--epe-jp);font-size:13px;color:var(--epe-text-muted);}
      .epe-blogcard__title{font-family:var(--epe-jp);font-size:15px;color:var(--epe-text-white);line-height:1.5;}
    </style>
    {{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
    {% render 'css', css: 'component-drawer.css' %}

    {%- if settings.enable_predictive_search -%}
      {% render 'css', css: 'component-predictive-search.css' %}
      <script src="{{- 'predictive-search.js' | asset_url -}}" defer="defer"></script>
    {%- endif -%}

    {% comment %}theme-check-disable AssetPreload{% endcomment %}
    {%- unless settings.type_heading_font.system? -%}
      <link rel="preload" as="font" href="{{ settings.type_heading_font | font_url }}" type="font/woff2" crossorigin>
    {%- endunless -%}
    {%- unless settings.type_body_font.system? -%}
      <link rel="preload" as="font" href="{{ settings.type_body_font | font_url }}" type="font/woff2" crossorigin>
      {%- endunless -%}
    {% comment %}theme-check-enable AssetPreload{% endcomment %}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      if (Shopify.designMode) {
        document.documentElement.classList.add('shopify-design-mode');
      }
    </script>
  </head>

  <body class="template template--{{ template.name }}{% if template.suffix %} template--{{- template.suffix -}}{% endif %} is-at-top">
    <a class="skip-to-content-link button visually-hidden" href="#MainContent">
      {{- 'theme.accessibility.skip_to_content' | t -}}
    </a>

    {%- sections 'header-group' -%}

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    <footer class="js-animation-fade-in">
      {%- sections 'footer-group' -%}
    </footer>

    {%- sections 'overlay-group' -%}

    {%- render 'ec-motion' -%}

    <ul hidden>
      <li id="a11y-refresh-page-message">{{- 'theme.accessibility.refresh_page' | t -}}</li>
    </ul>

    <script>
      window.theme = window.theme || {};
      theme = {
        settings: {
          money_format: {{ shop.money_format | json }},
          money_with_currency_format: {{ shop.money_with_currency_format | json }},
          cart_free_shipping_threshold: {{ settings.shipping_notification_threshold | times: 100 }},
          cart_free_shipping_text: `{{ 'cart.free_shipping_text_html' | t: amount: '0' }}`,
          cart_free_shipping_text_success: `{{ 'cart.free_shipping_text_success' | t }}`,
        }
      }
      window.shopUrl = '{{ request.origin }}';
      window.routes = {
        cart_url: '{{ routes.cart_url }}',
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}',
        search_url: '{{ routes.search_url }}',
        predictive_search_url: '{{ routes.predictive_search_url }}',
      };
      window.cartStrings = {
        error: `{{ 'cart.error' | t }}`,
        quantityError: `{{ 'cart.quantity_error_html' | t: quantity: '[quantity]' }}`
      }
      window.variantStrings = {
        addToCart: '{{ 'theme.actions.add_to_cart' | t }}',
        unavailable: '{{ 'product.unavailable' | t }}',
        soldOut: '{{ 'product.sold_out' | t }}',
        addSubscriptionToCart: 'Add subscription to cart',
        preOrder: '{{ 'product.preorder' | t }}'
      }
      window.validationStrings = {
        invalidEmail: '{{ 'theme.form.invalid_email' | t }}'
      }
      window.accessibilityStrings = {
        recipientFormExpanded: `{{ 'gift_card.recipient.expanded' | t }}`,
        recipientFormCollapsed: `{{ 'gift_card.recipient.collapsed' | t }}`,
      };
      window.actionStrings = {
        showMore: '{{ 'theme.actions.show_more' | t }}',
        showLess: '{{ 'theme.actions.show_less' | t }}',
      };
    </script>

    {% if settings.back_to_top_button != 'disable' %}
      <back-to-top class="hide">
        <button href="#" class="button back-to-top back-to-top--{{ settings.back_to_top_button_position }} {{ settings.back_to_top_button }}">
          {% render 'icon', icon_name: 'theme-chevron', class: 'icon--rotate-270' %}
        </button>
      </back-to-top>
    {% endif %}

    {% render 'subify-snippet' %}
    <country-drawer class="drawer">
      {%- render 'country-drawer', append_id: 'theme' -%}
    </country-drawer>
  </body>
</html>
