{%- comment -%}
  エペナイロン 汎用画像タイル（Pencil: dPk87 ImageCard）
  Params: image, alt, link(optional), name(optional), price(optional)
{%- endcomment -%}
{%- liquid
  assign card_tag = 'div'
  if link != blank
    assign card_tag = 'a'
  endif
-%}
<{{ card_tag }}{% if link != blank %} href="{{ link }}"{% endif %} class="epe-imgcard">
  <div class="epe-imgcard__img"{% if image != blank %} style="background-image:url({{ image | image_url: width: 900 }});"{% endif %}></div>
  {%- if name != blank -%}<div class="epe-imgcard__name">{{ name }}</div>{%- endif -%}
  {%- if price != blank -%}<div class="epe-imgcard__price">{{ price }}</div>{%- endif -%}
</{{ card_tag }}>
