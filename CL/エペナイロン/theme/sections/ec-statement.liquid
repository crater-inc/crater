{%- comment -%} EC テンプレ ブランドステートメント帯（2カラム） {%- endcomment -%}
<style>
  .ec-stmt{background:linear-gradient(160deg,var(--ec-dark1),var(--ec-dark2));color:var(--ec-white);
    display:grid;grid-template-columns:1fr 1fr;gap:48px;padding:112px 64px;align-items:start;}
  .ec-stmt__eye{font-family:var(--ec-en);font-size:12px;letter-spacing:4px;color:#f7f4ef99;margin-top:28px;}
  .ec-stmt__t{font-family:var(--ec-jp)!important;font-weight:600;color:var(--ec-white)!important;
    font-size:clamp(34px,3.8vw,50px);margin:0;line-height:1.4;letter-spacing:.04em;}
  .ec-stmt__body{font-family:var(--ec-jp);font-size:16px;line-height:2;letter-spacing:.04em;
    color:#f7f4efcc;margin:0;white-space:pre-line;}
  @media(max-width:768px){.ec-stmt{grid-template-columns:1fr;gap:32px;padding:72px 32px;}}
</style>
<section class="ec ec-stmt">
  <div class="ec-stmt__left">
    <h2 class="ec-stmt__t">{{ section.settings.heading }}</h2>
    {%- if section.settings.eyebrow != blank -%}<div class="ec-stmt__eye">{{ section.settings.eyebrow }}</div>{%- endif -%}
  </div>
  <p class="ec-stmt__body">{{ section.settings.body }}</p>
</section>
{% schema %}
{
  "name": "EC Statement",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "上ラベル", "default": "CONCEPT" },
    { "type": "text", "id": "heading", "label": "見出し", "default": "ブランドの世界観を伝える見出しが入ります。" },
    { "type": "textarea", "id": "body", "label": "ステートメント本文", "default": "ここにブランドのステートメント本文が入ります。\n\nどんな想いでこのブランドをつくったか、どんな体験を届けたいか。\n\n読み手の心に残るメッセージを、\nここで丁寧に伝えます。" }
  ],
  "presets": [{ "name": "EC Statement" }]
}
{% endschema %}
