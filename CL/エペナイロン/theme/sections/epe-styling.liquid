{%- comment -%} エペナイロン Styling（Pencil PC: E5kL2／SP: HVE8i）。ルックブック風・キャプションなしの画像グリッド {%- endcomment -%}
<style>
  .epe-styling{background:var(--epe-section-bg);padding:90px 80px;display:flex;flex-direction:column;gap:36px;}
  .epe-styling h2{font-family:var(--epe-en);font-size:30px;font-weight:700;color:var(--epe-text-white);margin:0;}
  .epe-styling__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;}
  @media(max-width:768px){
    .epe-styling{padding:56px 24px;gap:22px;}
    .epe-styling h2{font-size:24px;}
    .epe-styling__grid{grid-template-columns:1fr;gap:18px;}
  }
</style>
<section class="epe epe-styling" id="styling">
  <h2>{{ section.settings.heading }}</h2>
  <div class="epe-styling__grid">
    {%- for block in section.blocks -%}
      {%- render 'epe-image-card', image: block.settings.image, link: block.settings.link %}
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "EPE Styling",
  "settings": [
    { "type": "text", "id": "heading", "label": "見出し", "default": "Styling" }
  ],
  "blocks": [
    { "type": "item", "name": "画像", "settings": [
      { "type": "image_picker", "id": "image", "label": "画像（未設定＝グレープレースホルダー）" },
      { "type": "url", "id": "link", "label": "リンク" }
    ]}
  ],
  "presets": [{
    "name": "EPE Styling",
    "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }]
  }]
}
{% endschema %}
