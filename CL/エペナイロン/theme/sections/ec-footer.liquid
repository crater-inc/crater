{%- comment -%} EC テンプレ フッター {%- endcomment -%}
<style>
  .ec-ft{background:var(--ec-footer);color:var(--ec-white);padding:76px 64px 44px;}
  .ec-ft__top{display:flex;justify-content:space-between;gap:56px;flex-wrap:wrap;}
  .ec-ft__nl{max-width:380px;display:flex;flex-direction:column;gap:16px;}
  .ec-ft__nlh{font-family:var(--ec-en);font-size:12px;letter-spacing:3px;color:#f7f4ef99;}
  .ec-ft__nld{font-family:var(--ec-jp);font-size:14px;line-height:1.7;color:#f7f4efcc;margin:0;}
  .ec-ft__form{display:flex;align-items:center;justify-content:space-between;background:#f2f2f2;padding:0 20px;height:50px;}
  .ec-ft__form input{border:0;background:transparent;flex:1;font-family:var(--ec-jp);font-size:16px;color:#1a1a1a;outline:none;}
  .ec-ft__form button{border:0;background:transparent;cursor:pointer;font-family:var(--ec-en);font-size:12px;letter-spacing:2px;color:#1a1a1a;}
  .ec-ft__cols{display:flex;gap:64px;flex-wrap:wrap;}
  .ec-ft__col h4{font-family:var(--ec-en);font-size:12px;letter-spacing:2px;color:#f7f4ef99;margin:0 0 14px;}
  .ec-ft__col a{display:block;font-family:var(--ec-jp);font-size:13px;color:#f7f4efcc;text-decoration:none;margin-bottom:12px;}
  .ec-ft__col a:hover{color:#fff;}
  .ec-ft__bottom{display:flex;justify-content:space-between;align-items:flex-end;margin-top:64px;flex-wrap:wrap;gap:24px;}
  .ec-ft__logo{width:150px;}
  .ec-ft__logo img{width:100%;height:auto;display:block;}
  .ec-ft__tag{font-family:var(--ec-jp);font-size:13px;color:#f7f4ef99;margin-top:16px;}
  .ec-ft__sns a{color:#f7f4ef;}
  .ec-ft__sns svg{width:20px;height:20px;stroke:#f7f4ef;fill:none;stroke-width:1.5;}
  @media(max-width:768px){.ec-ft{padding:56px 32px 40px;}.ec-ft__cols{gap:36px;}}
</style>
<section class="ec ec-ft">
  <div class="ec-ft__top">
    <div class="ec-ft__nl">
      <div class="ec-ft__nlh">NEWSLETTER</div>
      <p class="ec-ft__nld">{{ section.settings.nl_text }}</p>
      <form class="ec-ft__form" onsubmit="return false;">
        <input type="email" placeholder="メールアドレス" aria-label="email">
        <button type="submit">SUBSCRIBE</button>
      </form>
    </div>
    <div class="ec-ft__cols">
      <div class="ec-ft__col"><h4>SHOP</h4>
        <a href="/collections/all">商品カテゴリA</a><a href="/collections/all">商品カテゴリB</a><a href="/collections/all">商品カテゴリC</a><a href="/collections/all">セット商品</a></div>
      <div class="ec-ft__col"><h4>MENU</h4>
        <a href="/">ホーム</a><a href="/pages/about">ブランドについて</a><a href="/pages/about">こだわり</a><a href="/pages/about">お客様の声</a><a href="/blogs/journal">ジャーナル</a></div>
      <div class="ec-ft__col"><h4>SUPPORT</h4>
        <a href="/pages/faq">よくある質問</a><a href="/pages/contact">お問い合わせ</a>{%- if shop.refund_policy != blank -%}<a href="{{ shop.refund_policy.url }}">返品・返金</a>{%- endif -%}{%- if shop.privacy_policy != blank -%}<a href="{{ shop.privacy_policy.url }}">プライバシー</a>{%- endif -%}{%- if shop.terms_of_service != blank -%}<a href="{{ shop.terms_of_service.url }}">利用規約</a>{%- endif -%}<a href="/policies/legal-notice">特定商取引法</a></div>
    </div>
  </div>
  <div class="ec-ft__bottom">
    <div>
      <div class="ec-ft__logo"><img src="{{ 'ec-logo-white.png' | asset_url }}" alt="{{ shop.name }}" width="150"></div>
      <div class="ec-ft__tag">{{ section.settings.tagline }}</div>
    </div>
    <div class="ec-ft__sns">
      <a href="{{ section.settings.instagram | default: '#' }}" aria-label="Instagram"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="#f7f4ef" stroke="none"/></svg></a>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "EC Footer",
  "settings": [
    { "type": "textarea", "id": "nl_text", "label": "ニュースレター文", "default": "会員登録で最新情報やお得な情報をお届けします。" },
    { "type": "text", "id": "tagline", "label": "タグライン", "default": "ブランドのタグラインが入ります。" },
    { "type": "url", "id": "instagram", "label": "Instagram URL" }
  ]
}
{% endschema %}
