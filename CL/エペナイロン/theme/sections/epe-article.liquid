{%- comment -%} エペナイロン ブログ記事詳細。Pencilに未着手のため既存トーンで新規デザイン {%- endcomment -%}
<style>
  .epe-article{background:var(--epe-section-bg);padding:72px 80px 90px;}
  .epe-article__wrap{max-width:760px;margin:0 auto;}
  .epe-article__back{display:inline-block;font-family:var(--epe-en);font-size:12px;color:var(--epe-text-muted);text-decoration:none;margin-bottom:24px;}
  .epe-article__date{font-family:var(--epe-jp);font-size:13px;color:var(--epe-text-muted);margin-bottom:10px;}
  .epe-article__title{font-family:var(--epe-jp);font-size:clamp(24px,3vw,34px);font-weight:700;color:var(--epe-text-white);margin:0 0 32px;line-height:1.4;}
  .epe-article__img{width:100%;height:420px;background:var(--epe-img-placeholder);background-size:cover;background-position:center;margin-bottom:40px;}
  .epe-article__body{font-family:var(--epe-jp);font-size:15px;line-height:1.9;color:var(--epe-text-body);}
  .epe-article__body p{margin:0 0 1.4em;}
  @media(max-width:768px){
    .epe-article{padding:48px 24px 56px;}
    .epe-article__img{height:240px;}
  }
</style>
<section class="epe epe-article">
  <div class="epe-article__wrap">
    <a class="epe-article__back" href="{{ blog.url }}">← {{ blog.title | default: 'Journal' }}</a>
    <div class="epe-article__date">{{ article.published_at | date: '%Y年 %m月 %d日' }}</div>
    <h1 class="epe-article__title">{{ article.title }}</h1>
    <div class="epe-article__img"{% if article.image %} style="background-image:url({{ article.image | image_url: width: 1400 }});"{% endif %}></div>
    <div class="epe-article__body">{{ article.content }}</div>
  </div>
</section>
{% schema %}
{
  "name": "EPE Article",
  "presets": [{ "name": "EPE Article" }]
}
{% endschema %}
