{%- comment -%} エペナイロン 商品一覧（コレクション）。Pencilに未着手のため既存トーンで新規デザイン {%- endcomment -%}
<style>
  .epe-col{background:var(--epe-section-bg);}
  .epe-col__hero{padding:72px 80px 40px;}
  .epe-col__crumb{font-family:var(--epe-en);font-size:12px;letter-spacing:2px;color:var(--epe-text-muted);margin-bottom:14px;}
  .epe-col__title{font-family:var(--epe-en);font-weight:700;font-size:clamp(36px,5vw,52px);color:var(--epe-text-white);line-height:1;margin:0 0 10px;}
  .epe-col__sub{font-family:var(--epe-jp);font-size:14px;color:var(--epe-text-muted);margin:0;}
  .epe-col__bar{display:flex;justify-content:space-between;align-items:center;padding:0 80px 32px;border-bottom:1px solid var(--epe-line);margin:0 80px;}
  .epe-col__count{font-family:var(--epe-en);font-size:13px;color:var(--epe-text-muted);}
  .epe-col__sort{display:flex;align-items:center;gap:8px;font-family:var(--epe-jp);font-size:13px;color:var(--epe-text-muted);}
  .epe-col__sort select{border:0;background:transparent;font-family:var(--epe-jp);font-size:13px;color:var(--epe-text-white);cursor:pointer;}
  .epe-col__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;padding:56px 80px 90px;}
  @media(max-width:768px){
    .epe-col__hero{padding:48px 24px 28px;}
    .epe-col__bar{padding:0 24px 24px;margin:0 24px;}
    .epe-col__grid{grid-template-columns:1fr;gap:36px;padding:40px 24px 64px;}
  }
</style>
<section class="epe epe-col">
  <div class="epe-col__hero">
    <div class="epe-col__crumb">Home / Shop</div>
    <h1 class="epe-col__title">{{ section.settings.title | default: collection.title | default: 'Shop' }}</h1>
    {%- if section.settings.subheading != blank -%}<p class="epe-col__sub">{{ section.settings.subheading }}</p>{%- endif -%}
  </div>
  <div class="epe-col__bar">
    <div class="epe-col__count">{{ collection.products_count | default: 0 }} {% if collection.products_count == 1 %}item{% else %}items{% endif %}</div>
    {%- if collection.sort_options.size > 0 -%}
      <div class="epe-col__sort">
        <label for="EpeSort">Sort</label>
        <select id="EpeSort" onchange="if(this.value){window.location.href=this.value}">
          {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
          {%- for option in collection.sort_options -%}
            <option value="{{ collection.url }}?sort_by={{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
      </div>
    {%- endif -%}
  </div>
  <div class="epe-col__grid">
    {%- if collection.products.size > 0 -%}
      {%- for product in collection.products -%}
        {%- render 'epe-image-card', image: product.featured_image, alt: product.title, link: product.url, name: product.title, price: product.price | money %}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..6) -%}
        {%- render 'epe-image-card', name: '商品名が入ります', price: '¥0,000（税込）' %}
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "EPE Collection",
  "settings": [
    { "type": "text", "id": "title", "label": "見出し（未設定＝コレクション名）" },
    { "type": "text", "id": "subheading", "label": "サブテキスト" }
  ],
  "presets": [{ "name": "EPE Collection" }]
}
{% endschema %}
