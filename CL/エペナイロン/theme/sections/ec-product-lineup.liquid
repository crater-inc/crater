{%- comment -%} EC テンプレ 商品ラインナップ {%- endcomment -%}
<style>
  .ec-lineup{background:#a6a6a6;padding:84px 64px;}
  .ec-head{display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:16px;margin-bottom:40px;}
  .ec-head__t{font-family:var(--ec-en);font-weight:600;font-size:clamp(40px,5vw,64px);color:var(--ec-ink);margin:0;line-height:1;}
  .ec-head__jp{font-family:var(--ec-jp);font-weight:600;font-size:13px;letter-spacing:3px;color:var(--ec-sub);margin-top:8px;}
  .ec-head__va{font-family:var(--ec-en);font-size:15px;letter-spacing:1px;color:var(--ec-ink);text-decoration:none;display:flex;align-items:center;gap:7px;}
  .ec-head__va:hover{opacity:.6;}
  .ec-lineup__row{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;}
  .ec-card{display:block;text-decoration:none;color:inherit;}
  .ec-card__img{width:100%;aspect-ratio:3/4;background:linear-gradient(135deg,#d6d6d6,#aeaeae);overflow:hidden;border-radius:8px;}
  .ec-card__img img{width:100%;height:100%;object-fit:cover;display:block;opacity:1!important;}
  .ec-card__nm{font-family:var(--ec-jp);font-weight:600;font-size:18px;color:var(--ec-ink);margin:14px 0 4px;}
  .ec-card__pr{font-family:var(--ec-jp);font-size:15px;color:#555;}
  @media(max-width:768px){.ec-lineup{padding:56px 32px;}.ec-lineup__row{grid-template-columns:1fr;gap:36px;}}
</style>
<section class="ec ec-lineup">
  <div class="ec-head">
    <div>
      <h2 class="ec-head__t">{{ section.settings.heading }}</h2>
      <div class="ec-head__jp">{{ section.settings.subheading }}</div>
    </div>
    {%- if section.settings.view_all_label != blank -%}
      <a class="ec-head__va" href="{{ section.settings.view_all_link | default: '/collections/all' }}">{{ section.settings.view_all_label }}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="4" y1="12" x2="20" y2="12"/><polyline points="14 6 20 12 14 18"/></svg></a>
    {%- endif -%}
  </div>
  <div class="ec-lineup__row">
    {%- assign ec_col = section.settings.collection -%}
    {%- if ec_col == blank -%}{%- assign ec_col = collections.all -%}{%- endif -%}
    {%- if ec_col.products.size > 0 -%}
      {%- for product in ec_col.products limit: 3 -%}
        <a class="ec-card" href="{{ product.url }}">
          <div class="ec-card__img">
            {%- if product.featured_image -%}<img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}" loading="lazy">
            {%- else -%}<img src="{{ 'ec-dummy-photo.jpg' | asset_url }}" alt="{{ product.title | escape }}" loading="lazy">{%- endif -%}
          </div>
          <div class="ec-card__nm">{{ product.title }}</div>
          <div class="ec-card__pr">{{ product.price | money }}</div>
        </a>
      {%- endfor -%}
    {%- else -%}
      {%- for block in section.blocks -%}
        <a class="ec-card" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
          <div class="ec-card__img">{%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.name | escape }}" loading="lazy">{%- else -%}<img src="{{ 'ec-dummy-photo.jpg' | asset_url }}" alt="" loading="lazy">{%- endif -%}</div>
          <div class="ec-card__nm">{{ block.settings.name }}</div>
          <div class="ec-card__pr">{{ block.settings.price }}</div>
        </a>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "EC Lineup",
  "settings": [
    { "type": "text", "id": "heading", "label": "見出し(英語)", "default": "Our Lineup" },
    { "type": "collection", "id": "collection", "label": "表示するコレクション（未選択＝全商品を自動表示）" },
    { "type": "text", "id": "subheading", "label": "サブ(日本語)", "default": "商品ラインナップ" },
    { "type": "text", "id": "view_all_label", "label": "View allラベル", "default": "View all" },
    { "type": "url", "id": "view_all_link", "label": "View allリンク" }
  ],
  "blocks": [
    { "type": "item", "name": "商品", "settings": [
      { "type": "image_picker", "id": "image", "label": "商品画像（未設定＝グレーのダミー）" },
      { "type": "text", "id": "name", "label": "商品名", "default": "商品名が入ります" },
      { "type": "text", "id": "price", "label": "価格", "default": "¥0,000（税込）" },
      { "type": "url", "id": "link", "label": "リンク" }
    ]}
  ],
  "presets": [{
    "name": "EC Lineup",
    "blocks": [
      { "type": "item", "settings": { "name": "商品名が入ります", "price": "¥0,000（税込）" } },
      { "type": "item", "settings": { "name": "商品名が入ります", "price": "¥0,000（税込）" } },
      { "type": "item", "settings": { "name": "商品名が入ります", "price": "¥0,000（税込）" } }
    ]
  }]
}
{% endschema %}
