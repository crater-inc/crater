{%- comment -%} EC テンプレ お客様の声 {%- endcomment -%}
<style>
  .ec-voice{background:#363636;padding:84px 64px;}
  .ec-voice__t{font-family:var(--ec-en);font-weight:600;font-size:clamp(40px,5vw,64px);color:var(--ec-white)!important;margin:0;line-height:1;}
  .ec-voice__jp{font-family:var(--ec-jp);font-weight:600;font-size:13px;letter-spacing:3px;color:#f7f4ef99;margin:8px 0 40px;}
  .ec-voice__row{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;}
  .ec-voice__card{background:#fff;padding:32px;border-radius:4px;display:flex;flex-direction:column;gap:14px;}
  .ec-voice__star{font-size:15px;letter-spacing:2px;color:#c9a227;}
  .ec-voice__ct{font-family:var(--ec-en);font-size:17px;color:var(--ec-ink);margin:0;}
  .ec-voice__cq{font-family:var(--ec-jp);font-size:14px;line-height:1.8;color:#555;margin:0;}
  @media(max-width:768px){.ec-voice{padding:56px 32px;}.ec-voice__row{grid-template-columns:1fr;}}
</style>
<section class="ec ec-voice">
  <h2 class="ec-voice__t">{{ section.settings.heading }}</h2>
  <div class="ec-voice__jp">{{ section.settings.subheading }}</div>
  <div class="ec-voice__row">
    {%- for block in section.blocks -%}
      <div class="ec-voice__card" {{ block.shopify_attributes }}>
        <div class="ec-voice__star">★★★★★</div>
        <p class="ec-voice__ct">{{ block.settings.title }}</p>
        <p class="ec-voice__cq">{{ block.settings.quote }}</p>
      </div>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "EC Voice",
  "settings": [
    { "type": "text", "id": "heading", "label": "見出し(英語)", "default": "Customer Voice" },
    { "type": "text", "id": "subheading", "label": "サブ(日本語)", "default": "お客様の声" }
  ],
  "blocks": [
    { "type": "voice", "name": "声", "settings": [
      { "type": "text", "id": "title", "label": "タイトル", "default": "満足の一言タイトル" },
      { "type": "textarea", "id": "quote", "label": "本文", "default": "お客様の感想がここに入ります。" }
    ]}
  ],
  "presets": [{
    "name": "EC Voice",
    "blocks": [
      { "type": "voice", "settings": { "title": "満足の一言タイトル", "quote": "お客様の感想がここに入ります。" } },
      { "type": "voice", "settings": { "title": "満足の一言タイトル", "quote": "お客様の感想がここに入ります。" } },
      { "type": "voice", "settings": { "title": "満足の一言タイトル", "quote": "お客様の感想がここに入ります。" } }
    ]
  }]
}
{% endschema %}
