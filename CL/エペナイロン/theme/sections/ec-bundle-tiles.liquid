{%- comment -%} EC テンプレ セット売り2枚タイル {%- endcomment -%}
<style>
  .ec-sets{display:grid;grid-template-columns:repeat({{ section.blocks.size }},1fr);}
  .ec-sets__tile{position:relative;overflow:hidden;aspect-ratio:720/742;min-height:420px;
    background:linear-gradient(150deg,#6f6f6f,#454545);display:block;color:var(--ec-white);text-decoration:none;}
  .ec-sets__bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 50%;display:block;z-index:0;}
  .ec-sets__ov{position:absolute;inset:0;z-index:1;background:linear-gradient(160deg,rgba(0,0,0,.5),rgba(0,0,0,.14) 45%,rgba(0,0,0,.45));}
  .ec-sets__copy{position:absolute;top:56px;left:56px;z-index:2;}
  .ec-sets__t{font-family:var(--ec-en);font-weight:600;font-size:clamp(34px,4vw,52px);margin:0;color:var(--ec-white);letter-spacing:.02em;}
  .ec-sets__d{font-family:var(--ec-jp);font-size:14px;line-height:1.6;color:#f7f4efcc;margin:0 0 6px;}
  .ec-sets__btn{position:absolute;right:56px;bottom:56px;z-index:2;border:1px solid #f7f4ef;border-radius:30px;padding:13px 34px;
    color:#f7f4ef;font-family:var(--ec-en);font-size:12px;letter-spacing:2px;}
  @media(max-width:768px){.ec-sets{grid-template-columns:1fr;}.ec-sets__copy{top:36px;left:32px;}.ec-sets__btn{right:32px;bottom:36px;}}
</style>
<section class="ec ec-sets">
  {%- for block in section.blocks -%}
    <a class="ec-sets__tile" href="{{ block.settings.link | default: '/collections/all' }}" {{ block.shopify_attributes }}>
      {%- if block.settings.image != blank -%}
        <img class="ec-sets__bg" src="{{ block.settings.image | image_url: width: 1600 }}" alt="{{ block.settings.title | escape }}" loading="lazy"><div class="ec-sets__ov"></div>
      {%- else -%}
        <img class="ec-sets__bg" src="{{ 'ec-tile-placeholder.jpg' | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy"><div class="ec-sets__ov"></div>
      {%- endif -%}
      <div class="ec-sets__copy">
        <p class="ec-sets__d">{{ block.settings.desc }}</p>
        <h2 class="ec-sets__t">{{ block.settings.title }}</h2>
      </div>
      <span class="ec-sets__btn">{{ block.settings.button | default: 'SHOP NOW' }}</span>
    </a>
  {%- endfor -%}
</section>
{% schema %}
{
  "name": "EC Sets",
  "blocks": [
    { "type": "tile", "name": "タイル", "settings": [
      { "type": "image_picker", "id": "image", "label": "タイル背景画像（未設定＝グレーのダミー）" },
      { "type": "text", "id": "title", "label": "英語タイトル", "default": "Tile Title" },
      { "type": "textarea", "id": "desc", "label": "説明", "default": "ここにタイルの説明が入ります" },
      { "type": "text", "id": "button", "label": "ボタン", "default": "SHOP NOW" },
      { "type": "url", "id": "link", "label": "リンク" }
    ]}
  ],
  "presets": [{
    "name": "EC Sets",
    "blocks": [
      { "type": "tile", "settings": { "title": "Tile Title A", "desc": "ここにタイルの説明が入ります" } },
      { "type": "tile", "settings": { "title": "Tile Title B", "desc": "ここにタイルの説明が入ります" } }
    ]
  }]
}
{% endschema %}
