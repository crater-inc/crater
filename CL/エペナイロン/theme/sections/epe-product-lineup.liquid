{%- comment -%} エペナイロン TOP Product（Pencil PC: E6kRUw／SP: BHSNu） {%- endcomment -%}
<style>
  .epe-plineup{background:var(--epe-section-bg);padding:0 80px 90px;display:flex;flex-direction:column;gap:36px;}
  .epe-plineup__head{display:flex;align-items:center;justify-content:space-between;}
  .epe-plineup__head h2{font-family:var(--epe-en);font-size:30px;font-weight:700;color:var(--epe-text-white);margin:0;}
  .epe-plineup__all{display:inline-flex;align-items:center;gap:8px;background:var(--epe-button-bg);color:var(--epe-text-white);
    font-family:var(--epe-en);font-size:13px;padding:13px 22px;text-decoration:none;}
  .epe-plineup__all svg{width:14px;height:14px;stroke:var(--epe-text-white);fill:none;stroke-width:1.5;}
  .epe-plineup__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;}
  @media(max-width:768px){
    .epe-plineup{padding:0 24px 56px;gap:22px;}
    .epe-plineup__head h2{font-size:24px;}
    .epe-plineup__grid{grid-template-columns:1fr;gap:18px;}
  }
</style>
<section class="epe epe-plineup" id="product">
  <div class="epe-plineup__head">
    <h2>{{ section.settings.heading }}</h2>
    <a class="epe-plineup__all" href="{{ section.settings.view_all_link | default: '/collections/all' }}">
      {{ section.settings.view_all_label }}
      <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
    </a>
  </div>
  <div class="epe-plineup__grid">
    {%- assign epe_col = section.settings.collection -%}
    {%- if epe_col == blank -%}{%- assign epe_col = collections.all -%}{%- endif -%}
    {%- if epe_col.products.size > 0 -%}
      {%- for product in epe_col.products limit: 3 -%}
        {%- assign product_price = product.price | money -%}
        {%- render 'epe-image-card', image: product.featured_image, alt: product.title, link: product.url, name: product.title, price: product_price, ratio: '4/5' %}
      {%- endfor -%}
    {%- else -%}
      {%- for block in section.blocks -%}
        {%- render 'epe-image-card', image: block.settings.image, alt: block.settings.name, link: block.settings.link, name: block.settings.name, price: block.settings.price, ratio: '4/5' %}
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "EPE Product Lineup",
  "settings": [
    { "type": "text", "id": "heading", "label": "見出し", "default": "Pickup Product" },
    { "type": "collection", "id": "collection", "label": "表示するコレクション（未選択＝全商品を自動表示）" },
    { "type": "text", "id": "view_all_label", "label": "ボタン文言", "default": "All" },
    { "type": "url", "id": "view_all_link", "label": "ボタンリンク" }
  ],
  "blocks": [
    { "type": "item", "name": "商品", "settings": [
      { "type": "image_picker", "id": "image", "label": "商品画像（未設定＝グレープレースホルダー）" },
      { "type": "text", "id": "name", "label": "商品名", "default": "商品名が入ります" },
      { "type": "text", "id": "price", "label": "価格", "default": "¥0,000（税込）" },
      { "type": "url", "id": "link", "label": "リンク" }
    ]}
  ],
  "presets": [{
    "name": "EPE Product Lineup",
    "blocks": [
      { "type": "item" }, { "type": "item" }, { "type": "item" }
    ]
  }]
}
{% endschema %}
