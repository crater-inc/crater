{%- comment -%}
  エペナイロン Contact（Pencil PC: pWtSp／SP: BYVdi）
  注意：Pencil元デザインの住所・電話は別の実在店舗のダミーデータだったため、ここでは汎用プレースホルダーに置き換えている。実データ確定後に差し替え必須。
{%- endcomment -%}
<style>
  .epe-contact{background:var(--epe-section-bg);display:flex;gap:70px;padding:90px 80px;}
  .epe-contact__left{flex:1;display:flex;flex-direction:column;gap:28px;}
  .epe-contact__left h2{font-family:var(--epe-en);font-size:30px;font-weight:700;color:var(--epe-text-white);margin:0;}
  .epe-contact__row{display:flex;gap:40px;padding:18px 0;border-bottom:1px solid var(--epe-line);}
  .epe-contact__label{font-family:var(--epe-en);font-size:14px;color:var(--epe-text-muted);width:110px;flex-shrink:0;}
  .epe-contact__value{font-family:var(--epe-jp);font-size:14px;color:var(--epe-text-white);}
  .epe-contact__photo{flex:1;background:var(--epe-img-placeholder);background-size:cover;background-position:center;min-height:340px;}
  @media(max-width:768px){
    .epe-contact{flex-direction:column;gap:24px;padding:56px 24px;}
    .epe-contact__left h2{font-size:24px;}
    .epe-contact__row{flex-direction:column;gap:6px;padding:16px 0;}
    .epe-contact__label{width:auto;}
    .epe-contact__photo{min-height:220px;}
  }
</style>
<section class="epe epe-contact" id="contact">
  <div class="epe-contact__left">
    <h2>{{ section.settings.heading }}</h2>
    <div class="epe-contact__table">
      {%- if section.settings.address != blank -%}
        <div class="epe-contact__row"><div class="epe-contact__label">Address</div><div class="epe-contact__value">{{ section.settings.address }}</div></div>
      {%- endif -%}
      {%- if section.settings.schedule != blank -%}
        <div class="epe-contact__row"><div class="epe-contact__label">Schedule</div><div class="epe-contact__value">{{ section.settings.schedule }}</div></div>
      {%- endif -%}
      {%- if section.settings.phone != blank -%}
        <div class="epe-contact__row"><div class="epe-contact__label">Phone</div><div class="epe-contact__value">{{ section.settings.phone }}</div></div>
      {%- endif -%}
      {%- if section.settings.email != blank -%}
        <div class="epe-contact__row"><div class="epe-contact__label">Email</div><div class="epe-contact__value">{{ section.settings.email }}</div></div>
      {%- endif -%}
    </div>
  </div>
  <div class="epe-contact__photo"{% if section.settings.photo != blank %} style="background-image:url({{ section.settings.photo | image_url: width: 1200 }});"{% endif %}></div>
</section>
{% schema %}
{
  "name": "EPE Contact",
  "settings": [
    { "type": "text", "id": "heading", "label": "見出し", "default": "Contact" },
    { "type": "text", "id": "address", "label": "住所", "default": "〒000-0000 ◯◯県◯◯市◯◯ 0-0-0" },
    { "type": "text", "id": "schedule", "label": "営業時間", "default": "10:00〜18:00（定休日：水・木）" },
    { "type": "text", "id": "phone", "label": "電話番号", "default": "00-0000-0000" },
    { "type": "text", "id": "email", "label": "メールアドレス", "default": "info@example.com" },
    { "type": "image_picker", "id": "photo", "label": "写真（未設定＝グレープレースホルダー）" }
  ],
  "presets": [{ "name": "EPE Contact" }]
}
{% endschema %}
