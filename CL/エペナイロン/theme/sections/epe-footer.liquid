{%- comment -%} エペナイロン フッター（Pencil: bRR5P）。Brand+3カラム(Navigation/Information/Legal)+区切り線+コピーライト {%- endcomment -%}
<style>
  .epe-ft{background:var(--epe-footer-bg);color:var(--epe-text-white);padding:64px 48px 32px;font-family:var(--epe-en);}
  .epe-ft__top{display:flex;justify-content:space-between;gap:60px;flex-wrap:wrap;}
  .epe-ft__brand{max-width:280px;display:flex;flex-direction:column;gap:16px;}
  .epe-ft__brand img{width:110px;height:auto;display:block;}
  .epe-ft__tagline{font-size:12.5px;line-height:1.6;color:var(--epe-text-muted);margin:0;}
  .epe-ft__sns{display:flex;align-items:center;gap:16px;}
  .epe-ft__sns a{color:var(--epe-text-white);display:flex;}
  .epe-ft__sns svg{width:18px;height:18px;stroke:var(--epe-text-white);fill:none;stroke-width:1.5;}
  .epe-ft__cols{display:flex;gap:64px;flex-wrap:wrap;}
  .epe-ft__col{width:170px;}
  .epe-ft__col h4{font-size:12px;letter-spacing:1px;color:var(--epe-text-muted);margin:0 0 14px;font-weight:400;}
  .epe-ft__col a{display:block;font-size:13px;color:var(--epe-text-white);text-decoration:none;margin-bottom:12px;}
  .epe-ft__col a:hover{opacity:.7;}
  .epe-ft__divider{height:1px;background:var(--epe-line);width:100%;margin:36px 0 0;}
  .epe-ft__bottom{padding-top:24px;font-size:11px;color:var(--epe-text-muted);}
  @media(max-width:768px){
    .epe-ft{padding:48px 24px 32px;}
    .epe-ft__top{flex-direction:column;gap:36px;}
    .epe-ft__cols{gap:28px;flex-direction:column;}
    .epe-ft__col{width:100%;}
  }
</style>
<section class="epe epe-ft">
  <div class="epe-ft__top">
    <div class="epe-ft__brand">
      <img src="{{ 'logo-horizontal-white.png' | asset_url }}" alt="{{ shop.name }}">
      <p class="epe-ft__tagline">{{ section.settings.tagline }}</p>
      <div class="epe-ft__sns">
        {%- if section.settings.facebook != blank -%}<a href="{{ section.settings.facebook }}" aria-label="Facebook"><svg viewBox="0 0 24 24"><path d="M14 9h3V6h-3c-1.7 0-3 1.3-3 3v2H9v3h2v6h3v-6h3l1-3h-4V9c0-.6.4-1 1-1z"/></svg></a>{%- endif -%}
        {%- if section.settings.twitter != blank -%}<a href="{{ section.settings.twitter }}" aria-label="X"><svg viewBox="0 0 24 24"><path d="M4 4l16 16M20 4L4 20"/></svg></a>{%- endif -%}
        {%- if section.settings.instagram != blank -%}<a href="{{ section.settings.instagram }}" aria-label="Instagram"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="var(--epe-text-white)" stroke="none"/></svg></a>{%- endif -%}
      </div>
    </div>
    <div class="epe-ft__cols">
      <div class="epe-ft__col">
        <h4>Navigation</h4>
        <a href="/">Home</a>
        <a href="{{ section.settings.about_link | default: '/#about' }}">About</a>
        <a href="{{ section.settings.product_link | default: '/#product' }}">Product</a>
        <a href="{{ section.settings.material_link | default: '/#material' }}">Material</a>
        <a href="{{ section.settings.styling_link | default: '/#styling' }}">Styling</a>
      </div>
      <div class="epe-ft__col">
        <h4>Information</h4>
        <a href="{{ section.settings.blog_link | default: '/blogs/journal' }}">Journal</a>
        <a href="{{ section.settings.contact_link | default: '/#contact' }}">Contact</a>
      </div>
      <div class="epe-ft__col">
        <h4>Legal</h4>
        {%- if shop.privacy_policy != blank -%}<a href="{{ shop.privacy_policy.url }}">Privacy Policy</a>{%- endif -%}
        {%- if shop.terms_of_service != blank -%}<a href="{{ shop.terms_of_service.url }}">Terms of Service</a>{%- endif -%}
        <a href="{{ section.settings.tokushoho_link | default: '/pages/legal-notice' }}">特定商取引法に基づく表記</a>
      </div>
    </div>
  </div>
  <div class="epe-ft__divider"></div>
  <div class="epe-ft__bottom">
    &copy; {{ 'now' | date: '%Y' }} EPE NYLON. All rights reserved.
  </div>
</section>
{% schema %}
{
  "name": "EPE Footer",
  "settings": [
    { "type": "textarea", "id": "tagline", "label": "タグライン", "default": "Functional beauty, born from subtraction." },
    { "type": "url", "id": "about_link", "label": "Aboutリンク" },
    { "type": "url", "id": "product_link", "label": "Productリンク" },
    { "type": "url", "id": "material_link", "label": "Materialリンク" },
    { "type": "url", "id": "styling_link", "label": "Stylingリンク" },
    { "type": "url", "id": "blog_link", "label": "Journalリンク" },
    { "type": "url", "id": "contact_link", "label": "Contactリンク" },
    { "type": "url", "id": "tokushoho_link", "label": "特定商取引法ページリンク" },
    { "type": "url", "id": "facebook", "label": "Facebook URL" },
    { "type": "url", "id": "twitter", "label": "X (Twitter) URL" },
    { "type": "url", "id": "instagram", "label": "Instagram URL" }
  ]
}
{% endschema %}
