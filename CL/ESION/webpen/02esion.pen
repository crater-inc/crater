                  "fill": "#FFFFFF",
                  "content": "ESION",
                  "fontFamily": "$font-en",
                  "fontSize": 34,
                  "fontWeight": "600",
                  "letterSpacing": 2
                },
                {
                  "type": "text",
                  "id": "kvEwD",
                  "name": "arrow",
                  "fill": "#6FA8FF",
                  "content": "⇄",
                  "fontFamily": "$font-en",
                  "fontSize": 18,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "W1v1R",
                  "name": "n",
                  "fill": "#3E5F92",
                  "content": "NOISE",
                  "fontFamily": "$font-en",
                  "fontSize": 34,
                  "fontWeight": "600",
                  "letterSpacing": 2
                }
              ]
            },
            {
              "type": "text",
              "id": "p1LXc",
              "name": "cap",
              "fill": "#9FB6CC",
              "content": "ESION を逆から読むと、NOISE。",
              "textAlign": "center",
              "fontFamily": "$font-jp",
              "fontSize": 13,
              "fontWeight": "normal",
              "letterSpacing": 0.5
            },
            {
              "type": "frame",
              "id": "hfAx8",
              "name": "body",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 14,
              "children": [
                {
                  "type": "text",
                  "id": "Slj1N",
                  "name": "p",
                  "fill": "#C4D3E0",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "ESIONは、「本質」を意味するEssenceと、「見通し」を意味するVisionを組み合わせた造語です。\nこの名前には、「本質を追求する」という思いを込めています。",
                  "lineHeight": 1.9,
                  "textAlign": "center",
                  "fontFamily": "$font-jp",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "UcgUU",
                  "name": "p",
                  "fill": "#C4D3E0",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "そしてESIONを逆から読むと「NOISE」。雑音のことです。\n流行や先入観、必要以上の情報によって、本当に大切なものが見えにくくなることがあります。",
                  "lineHeight": 1.9,
                  "textAlign": "center",
                  "fontFamily": "$font-jp",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "REcmh",
                  "name": "p",
                  "fill": "#C4D3E0",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "その雑音を取り除き、本質を見極める。\nESIONとNOISEは、私たちが目指すものと、その反対側にあるものを表しています。",
                  "lineHeight": 1.9,
                  "textAlign": "center",
                  "fontFamily": "$font-jp",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "y4GwXN",
          "name": "CHAPTER 03",
          "clip": true,
          "width": "fill_container",
          "fill": "#FFFFFF",
          "layout": "vertical",
          "children": [
            {
              "type": "rectangle",
              "id": "O8LKR",
              "name": "img",
              "fill": "#DDE2E9",
              "width": "fill_container",
              "height": 280
            },
            {
              "type": "frame",
              "id": "SXT56",
              "name": "body",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 14,
              "padding": [
                32,
                32,
                48,
                32
              ],
              "children": [
                {
                  "type": "text",
                  "id": "Ef45z",
                  "name": "label",
                  "fill": "#0D41A8",
                  "content": "CHAPTER 03",
                  "fontFamily": "$font-en",
                  "fontSize": 13,
                  "fontWeight": "600",
                  "letterSpacing": 2
                },
                {
                  "type": "text",
                  "id": "Y628qb",
                  "name": "h",
                  "fill": "#081B52",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "無香料は、\n香料を抜くだけではない。",
                  "lineHeight": 1.45,
                  "fontFamily": "$font-jp-head",
                  "fontSize": 24,
                  "fontWeight": "normal",
                  "letterSpacing": 1
                },
                {
                  "type": "text",
                  "id": "DdXCg",
                  "name": "en",
                  "fill": "#5E6E96",
                  "content": "Fragrance-free is more than removing fragrance.",
                  "fontFamily": "$font-en",
                  "fontSize": 9,
                  "fontWeight": "normal",
                  "letterSpacing": 1
                },
                {
                  "type": "text",
                  "id": "v6veyw",
                  "name": "p",
                  "fill": "#3D4655",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "無香料とは、香料を配合していないこと。無香性とは、においがしないこと。ESIONが目指したのは、香料を配合しない「無香料」にとどまらず、においがしない「無香性」でした。",
                  "lineHeight": 1.9,
                  "fontFamily": "$font-jp",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "IF7kB",
                  "name": "p",
                  "fill": "#3D4655",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "しかし、香料を配合しない処方にすると、これまで香料に隠れていた原料そのもののにおいが気になるようになりました。原料由来のにおいを香料で覆い隠さず、においを感じにくい原料で処方を組み立てることは、想像以上に困難でした。",
                  "lineHeight": 1.9,
                  "fontFamily": "$font-jp",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "TF0ey",
                  "name": "p",
                  "fill": "#3D4655",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "条件を満たす原料は限られています。一つひとつの原料のにおいを確かめながら、原料の選定、組み合わせ、配合バランスを見直していきました。",
                  "lineHeight": 1.9,
                  "fontFamily": "$font-jp",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "j5hAk",
                  "name": "p",
                  "fill": "#3D4655",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "ようやくにおいを抑えられても、原料を変更することで、泡立ちや洗い上がりまで変わってしまうことがあります。泡立ちだけを良くしても、理想の洗い上がりにはならない。指通りだけを重視しても、求める洗い心地には届かない。",
                  "lineHeight": 1.9,
                  "fontFamily": "$font-jp",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "nRvwP",
                  "name": "p",
                  "fill": "#3D4655",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "無香性を目指しながら、泡立ち、洗浄力、指通り、まとまりを両立させるために、何度も何度も試作と改良を繰り返しました。",
                  "lineHeight": 1.9,
                  "fontFamily": "$font-jp",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "YtFKH",
          "name": "CHAPTER 04",
