            },
            {
              "type": "text",
              "id": "dCJ9u",
              "name": "en",
              "fill": "#ffffff",
              "content": "Read in reverse, ESION becomes NOISE.",
              "textAlign": "center",
              "fontFamily": "$font-en",
              "fontSize": 9,
              "fontWeight": "normal",
              "letterSpacing": 1
            },
            {
              "type": "frame",
              "id": "PsZFB",
              "name": "typo",
              "gap": 6,
              "alignItems": "center",
              "children": [
                {
                  "type": "text",
