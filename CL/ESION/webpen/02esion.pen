                  "fontSize": 14,
                  "fontWeight": "500"
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "m6HRek",
          "name": "Intro",
          "clip": true,
          "width": "fill_container",
          "fill": "#FFFFFF",
