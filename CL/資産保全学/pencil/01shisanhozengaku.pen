                  "type": "text",
                  "id": "NSlah",
                  "name": "FAQQ_4",
                  "fill": "$text-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Q05　個別伴走サポートは無制限で相談できますか？",
                  "fontFamily": "$font-jp",
                  "fontSize": 16,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "YXu74",
                  "name": "FAQA_4",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "A　初回打合せから3か月を目安にサポートしています。",
