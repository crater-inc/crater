                  "id": "SzC7b",
                  "name": "FAQQ_10",
                  "fill": "$text-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Q11　全国どこからでも相談できますか？",
                  "fontFamily": "$font-jp",
                  "fontSize": 16,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "nqMcx",
                  "name": "FAQA_10",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "A　対面勉強会・面談は東京・大阪で定期開催していますが、それ以外の地域の方にはオンラインでご対応しています。",
                  "lineHeight": 1.8,
                  "fontFamily": "$font-jp",
