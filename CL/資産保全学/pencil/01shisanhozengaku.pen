                {
                  "type": "text",
                  "id": "Nezcp",
                  "name": "P_SectionTitle_3",
                  "fill": "$text-primary",
                  "content": "4. 個人情報の管理",
                  "fontFamily": "$font-jp",
                  "fontSize": 17,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "rXScS",
                  "name": "P_SectionBody_3",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "当社は、個人情報の漏洩・紛失・改ざん等を防止するため、適切な安全管理措置を講じます。",
                  "lineHeight": 1.8,
                  "fontFamily": "$font-jp",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
