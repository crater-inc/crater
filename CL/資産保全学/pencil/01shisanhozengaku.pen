                  "name": "P_SectionTitle_4",
                  "fill": "$text-primary",
                  "content": "5. 個人情報の開示・訂正・利用停止等の請求",
                  "fontFamily": "$font-jp",
                  "fontSize": 17,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
